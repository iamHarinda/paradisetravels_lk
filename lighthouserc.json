{
  "ci": {
    "collect": {
      "startServerCommand": "node ./dist/server/entry.mjs",
      "startServerReadyPattern": "Server listening",
      "url": ["http://localhost:4321/"],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.03 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1258291 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 61440 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
