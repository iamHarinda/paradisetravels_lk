---
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../ui/PhotoHero.astro';
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import CtaBlock from '../ui/CtaBlock.astro';
import { STAYS, STAY_IDS } from '../../data/stays';
import { getEntries, byOrder } from '../../lib/content';
import { photo } from '../../lib/photos';
import type { Lang } from '../../lib/i18n';

// "Hotels we use" (/hotels, /ko/hotels): the owner's list of tour hotels, area by area. Names only — rates are
// quoted as part of a tour (CLAUDE.md hard rule 2), and hotel photos wait until image rights are cleared.
interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const hotels = (await getEntries('hotels')).sort((a, b) => a.data.order - b.data.order || byOrder(a, b));
const areas = STAY_IDS.map((id) => ({ ...STAYS[id], hotels: hotels.filter((h) => h.data.stay === id) })).filter(
  (a) => a.hotels.length,
);
const hero = photo('kandalama-pool');
const T = ko
  ? {
      title: '스리랑카 투어 숙소',
      seoTitle: '스리랑카 투어 호텔 · 숙소 | 파라다이스 트래블스',
      seo: '네곰보, 시기리야, 콜롬보, 캔디, 누와라엘리야, 남부 해안까지 — 파라다이스 트래블스 투어에서 예약하는 지역별 호텔 목록입니다.',
      eyebrow: '숙소',
      intro: '여행 경로를 따라 지역별로 검증된 호텔을 예약해 드립니다. 요금은 투어 견적에 포함해 안내합니다.',
      note: '호텔 요금은 여행 일정과 시기에 따라 달라지며, 투어 견적과 함께 안내해 드립니다.',
      area: '지역',
      ctaTitle: '원하시는 호텔이 있으신가요?',
      ctaText: '목록에 없는 호텔도 예약해 드립니다. 편하게 문의해 주세요.',
      crumb: '숙소',
      href: '/ko/hotels',
    }
  : {
      title: 'Hotels for *your tour*',
      seoTitle: 'Sri Lanka Tour Hotels by Area | Paradise Travels',
      seo: 'The hotels Paradise Travels books for Sri Lanka tours: Negombo, Sigiriya and Dambulla, Colombo, Kandy, Nuwara Eliya and the south coast.',
      eyebrow: 'Where you’ll stay',
      intro:
        'We book these hotels along your route, area by area — and we can match others to your style and budget. Rates are quoted with your tour.',
      note: 'Hotel rates depend on your dates and room choice, so we quote them as part of your tour.',
      area: 'Area',
      ctaTitle: 'Have a hotel in mind?',
      ctaText: 'We can book hotels beyond this list too. Tell us what you like.',
      crumb: 'Hotels',
      href: '/hotels',
    };
---

<PageLayout title={T.seoTitle} description={T.seo} breadcrumbs={[{ name: T.crumb, href: T.href }]}>
  <PhotoHero eyebrow={T.eyebrow} title={T.title} intro={T.intro} image={hero.image} imageAlt={hero.alt} />

  <nav class="container-site sticky top-20 z-20 mt-8" aria-label={T.area}>
    <ul class="flex gap-2 overflow-x-auto rounded-pill bg-surface/90 p-1.5 shadow-card ring-1 ring-line backdrop-blur">
      {areas.map((a) => (
        <li class="shrink-0">
          <a
            href={`#${a.id}`}
            class="inline-flex min-h-11 items-center rounded-pill px-4 text-sm font-semibold whitespace-nowrap hover:bg-gold-100 dark:hover:bg-white/10"
          >
            {ko ? a.nameKo : a.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="container-site space-y-20 py-16">
    {areas.map((a, i) => {
      const p = photo(a.photo);
      return (
        <section id={a.id} class="scroll-mt-40" aria-labelledby={`${a.id}-heading`}>
          <div
            class:list={['grid items-center gap-8 lg:grid-cols-2 lg:gap-14', i % 2 && 'lg:[&>*:first-child]:order-2']}
          >
            <div class="reveal relative aspect-[4/3] overflow-hidden rounded-media shadow-card">
              <Media image={p.image} alt={p.alt} sizes="(min-width: 1024px) 45vw, 100vw" />
              <span class="absolute top-4 left-4 rounded-pill bg-ocean-900/85 px-3 py-1 font-display text-sm text-gold-300 italic backdrop-blur">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <div>
              <h2 id={`${a.id}-heading`} class="reveal text-h2">
                {ko ? a.nameKo : a.name}
              </h2>
              <p class="reveal mt-3 text-lg text-muted">{ko ? a.blurbKo : a.blurb}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {a.hotels.map((h) => (
                  <li class="reveal flex items-start gap-3 rounded-card bg-surface p-4 shadow-card ring-1 ring-line">
                    <Icon name="bed" class="mt-0.5 size-5 shrink-0 text-gold-600 dark:text-gold-400" />
                    <span>
                      <span class="block font-semibold">{h.data.name}</span>
                      <span class="block text-sm text-muted">{h.data.town}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      );
    })}
    <p class="text-sm text-muted">{T.note}</p>
  </div>

  <CtaBlock title={T.ctaTitle} text={T.ctaText} photoName="kandalama-sunset" />
</PageLayout>
