---
// Rate-parity-safe price display (docs/10 §1). Never shows a room-only price unless the hotel allows it.
interface Props {
  mode: 'public' | 'package' | 'on-request';
  priceFromUSD?: number | null;
  packageOffer?: string | null;
  class?: string;
}
const { mode, priceFromUSD, packageOffer, class: className } = Astro.props;
---

<div class={className}>
  {mode === 'public' && priceFromUSD ? (
    <p>
      <span class="text-2xl font-semibold">From US$ {priceFromUSD.toLocaleString('en-US')}</span>
      <span class="text-sm text-muted"> / night (room only)</span>
    </p>
  ) : mode === 'package' && packageOffer ? (
    <p class="font-semibold">{packageOffer}</p>
  ) : (
    <p>
      <span class="font-semibold">Paradise partner rate</span>
      <span class="block text-sm text-muted">Request your rate — we reply with a quote for your dates.</span>
    </p>
  )}
</div>
