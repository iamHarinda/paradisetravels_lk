---
import { SITE_ENV, NAVER_SITE_VERIFICATION, GOOGLE_SITE_VERIFICATION } from 'astro:env/server';
import { alternates, cleanPath, langFromPath } from '../../lib/i18n';
import { SITE } from '../../lib/site';
import { siteSchema } from '../../lib/schema-org';

export interface Props {
  /** ≤ 60 characters, unique per page. */
  title: string;
  /** 140–160 characters, unique per page. */
  description: string;
  /** Absolute or root-relative 1200×630 image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Page-specific JSON-LD, added after the site-wide Organization/WebSite. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = `${SITE.name} — Sri Lanka travel since ${SITE.foundingYear}`,
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Clean URLs (docs/03): `build.format: 'file'` reports `/index.html` / `/about.html` while prerendering.
const path = cleanPath(Astro.url.pathname);
const canonical = new URL(path, Astro.site);
// hreflang (docs/06 §6): English ↔ Korean twins, x-default = English. Naver and Google both read these.
const lang = langFromPath(path);
const alt = alternates(path);
const hreflang =
  alt.en && alt.ko
    ? [
        { lang: 'en', href: new URL(alt.en, Astro.site) },
        { lang: 'ko', href: new URL(alt.ko, Astro.site) },
        { lang: 'x-default', href: new URL(alt.en, Astro.site) },
      ]
    : [];
const imageUrl = new URL(image, Astro.site);
const robots = noindex || SITE_ENV !== 'production' ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const schema = [...siteSchema(), ...jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{hreflang.map((h) => (
  <link rel="alternate" hreflang={h.lang} href={h.href} />
))}
{NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={NAVER_SITE_VERIFICATION} />}
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_GB'} />
{alt.en && alt.ko && <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_GB' : 'ko_KR'} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="sitemap" href="/sitemap.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={lang === 'ko' ? '파라다이스 트래블스 — 스리랑카 여행' : 'Paradise Travels — Sri Lanka Travel Guide'}
  href={lang === 'ko' ? '/ko/rss.xml' : '/rss.xml'}
/>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
