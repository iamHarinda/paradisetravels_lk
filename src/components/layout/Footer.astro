---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import BrandBadge from '../ui/BrandBadge.astro';
import { SITE, whatsappLink } from '../../lib/site';
import { TOUR_TYPES } from '../../data/tour-types';
import { KO_GUIDES } from '../../data/ko-guides';
import { MARKETS, flagSrc } from '../../data/markets';
import { langFromPath } from '../../lib/i18n';

const ko = langFromPath(Astro.url.pathname) === 'ko';
const columns = ko
  ? [
      { title: '투어', links: TOUR_TYPES.map((t) => [t.ko.name, `/ko/tours/${t.id}`]) },
      {
        title: '서비스',
        links: [
          ['비자 상담', '/ko/visa'],
          ['항공권', '/ko/air-tickets'],
          ['숙소', '/ko/hotels'],
          ['기사 포함 투어', '/ko/private-driver'],
          ['7일 여행 코스', '/ko/itinerary/7-days'],
          ['회사 소개', '/ko/about'],
          ['문의', '/ko/contact'],
        ],
      },
      { title: '여행지', links: KO_GUIDES.map((g) => [`${g.name} 여행`, `/ko/destinations/${g.slug}`]) },
      {
        title: 'English',
        links: [
          ['Destinations', '/destinations'],
          ['Travel guide', '/travel-guide'],
          ['About us', '/about'],
          ['English home', '/'],
        ],
      },
    ]
  : [
      { title: 'Tours', links: [...TOUR_TYPES.map((t) => [t.en.name, `/tours/${t.id}`]), ['All tours', '/tours']] },
      {
        title: 'Services',
        links: [
          ['Visa consultation', '/services/visa-consultation'],
          ['Air ticketing', '/services/air-ticketing'],
          ['Hotels we use', '/hotels'],
          ['Plan your trip', '/plan-your-trip'],
        ],
      },
      {
        title: 'Explore',
        links: [
          ['Destinations', '/destinations'],
          ['Experiences', '/experiences'],
          ['Travel guide', '/travel-guide'],
          ['About us', '/about'],
          ['Reviews', '/reviews'],
          ['FAQ', '/faq'],
          ['Contact', '/contact'],
          ['한국어', '/ko'],
        ],
      },
    ];
const legal = [
  ['Terms', '/terms'],
  ['Privacy', '/privacy'],
  ['Cancellation policy', '/cancellation-policy'],
  ['Photo credits', '/photo-credits'],
];
---

<footer class="on-dark overflow-hidden bg-ocean-950 text-white/80">
  <div class="gold-rule" aria-hidden="true"></div>
  <div
    class:list={[
      'container-site grid gap-12 py-16 sm:grid-cols-2',
      ko ? 'lg:grid-cols-[1.4fr_repeat(4,1fr)]' : 'lg:grid-cols-[1.4fr_repeat(3,1fr)]',
    ]}
  >
    <div>
      <Logo href={ko ? '/ko' : '/'} />
      <p class="mt-4 max-w-sm text-sm">
        {ko
          ? `${SITE.legalName}. ${SITE.foundingYear}년부터 콜롬보에서 스리랑카 투어, 비자 상담, 항공권을 준비해 온 현지 여행사입니다.`
          : `${SITE.legalName}. A Colombo travel agency since ${SITE.foundingYear} — Sri Lanka tours, visa consultation and air tickets.`}
      </p>
      <address class="mt-6 space-y-2 text-sm not-italic">
        <a href={SITE.mapsUrl} class="flex gap-2 hover:text-white" rel="noopener">
          <Icon name="googlemaps" class="mt-0.5 size-4 shrink-0" />
          {SITE.addressLine}
        </a>
        <a href={`tel:${SITE.phoneE164}`} class="flex gap-2 hover:text-white" data-track="phone">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0" />
          {SITE.phone}
        </a>
        <a href={whatsappLink()} class="flex gap-2 hover:text-white" rel="noopener" data-track="whatsapp">
          <span class="mt-0.5 flex shrink-0 gap-1">
            <BrandBadge name="whatsapp" class="size-5" />
            <BrandBadge name="kakao" class="size-5" />
          </span>
          <span class="sr-only">{ko ? '왓츠앱 · 카카오톡' : 'WhatsApp & KakaoTalk'}:</span>
          {SITE.phone}
        </a>
        <a href={`mailto:${SITE.email}`} class="flex gap-2 hover:text-white" data-track="email">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0" />
          {SITE.email}
        </a>
      </address>
    </div>
    {columns.map((col) => (
      <nav aria-label={col.title}>
        <p class="detail font-sans text-gold-300">{col.title}</p>
        <ul class="mt-4 space-y-1 text-sm">
          {col.links.map(([label, href]) => (
            <li>
              <a href={href} class="inline-block py-1.5 hover:text-white">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container-site flex flex-wrap items-center gap-x-4 gap-y-3 pb-10">
    <p class="detail text-gold-300">{ko ? '주요 고객 국가' : 'Welcoming travellers from'}</p>
    <ul class="flex flex-wrap gap-2">
      {MARKETS.map((m) => (
        <li>
          <img
            src={flagSrc(m.code)}
            alt={ko ? m.nameKo : m.name}
            title={ko ? m.nameKo : m.name}
            width="24"
            height="18"
            loading="lazy"
            class="h-[18px] w-6 rounded-[2px] object-cover"
          />
        </li>
      ))}
    </ul>
  </div>
  <p
    class="pointer-events-none -mb-[0.18em] text-center font-display text-[9.5vw] leading-none font-semibold tracking-[-0.02em] whitespace-nowrap text-transparent select-none [-webkit-text-stroke:1px_rgb(217_169_74/0.35)]"
    aria-hidden="true"
  >
    Paradise Travels
  </p>
  <div class="border-t border-white/10">
    <div class="container-site flex flex-wrap items-center justify-between gap-4 py-6 pb-28 text-xs md:pb-6">
      <p>
        © {new Date().getFullYear()} {SITE.legalName}
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {legal.map(([label, href]) => (
          <li>
            <a href={href} class="hover:text-white">
              {label}
            </a>
          </li>
        ))}
        <li>
          <a href="/privacy" class="hover:text-white" data-consent-reopen>
            {ko ? '쿠키 설정' : 'Cookie settings'}
          </a>
        </li>
        <li>
          <a href={SITE.facebook} class="hover:text-white" rel="noopener">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="facebook" class="size-4" /> Facebook
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
