---
import { TURNSTILE_SITE_KEY } from 'astro:env/client';
import Button from '../ui/Button.astro';
import { SITE } from '../../lib/site';
import { langFromPath } from '../../lib/i18n';

// Honeypot + Turnstile + tracking fields + submit + live error region, shared by every lead form.
interface Props {
  submitLabel?: string;
}
const { submitLabel = 'Send request' } = Astro.props;
const ko = langFromPath(Astro.url.pathname) === 'ko';
---

<div class="absolute -left-[9999px]" aria-hidden="true">
  <label>
    Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" />
  </label>
</div>
<input type="hidden" name="page" />
<input type="hidden" name="utm_source" />
<input type="hidden" name="utm_medium" />
<input type="hidden" name="utm_campaign" />
{TURNSTILE_SITE_KEY && <div class="cf-turnstile mt-6" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto"></div>}
<p class="mt-6 text-sm font-semibold text-laterite-500" role="alert" aria-live="assertive" data-form-message></p>
<div class="mt-4 flex flex-wrap items-center gap-4">
  <Button type="submit" size="lg" data-submit>
    {submitLabel}
  </Button>
  {ko ? (
    <p class="text-sm text-muted">
      보내주신 정보는 답변 목적으로만 사용합니다 —{' '}
      <a href="/privacy" class="underline" lang="en">
        Privacy policy
      </a>
      . 채팅이 편하시면{' '}
      <a href={SITE.whatsapp} class="underline" rel="noopener">
        왓츠앱
      </a>{' '}
      또는 카카오톡({SITE.phone})으로 연락 주세요.
    </p>
  ) : (
    <p class="text-sm text-muted">
      We use your details only to reply to you — see our{' '}
      <a href="/privacy" class="underline">
        privacy policy
      </a>
      . Prefer chat?{' '}
      <a href={SITE.whatsapp} class="underline" rel="noopener">
        WhatsApp us
      </a>
      .
    </p>
  )}
</div>
