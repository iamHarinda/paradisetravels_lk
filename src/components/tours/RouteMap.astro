---
import MapLand from '../ui/MapLand.astro';
import { AIRPORT, MAP_VIEWBOX, project } from '../../lib/geo';

// Static SVG route map (docs/03 tour template). The route line draws itself as it scrolls into view.

interface Props {
  stops: { title: string; coords: [number, number] }[];
  class?: string;
}
const { stops, class: className } = Astro.props;
const points = [AIRPORT, ...stops.map((s) => s.coords), AIRPORT].map(project);
const route = points.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
---

<figure class={className}>
  <svg viewBox={MAP_VIEWBOX} class="w-full" role="img" aria-labelledby="route-title">
    <title id="route-title">Route map: {stops.map((s) => s.title).join(' → ')}</title>
    <MapLand id="route" />
    <path
      d={route}
      fill="none"
      stroke="#1E63D6"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      pathLength="1"
      class="route-line"
    ></path>
    {stops.map((s, i) => {
      const [x, y] = project(s.coords);
      return (
        <g>
          <circle cx={x} cy={y} r="7" fill="#1E63D6" />
          <text x={x} y={y + 3} font-size="8" font-weight="700" text-anchor="middle" fill="#FFFFFF">
            {i + 1}
          </text>
        </g>
      );
    })}
    <g>
      <circle cx={project(AIRPORT)[0]} cy={project(AIRPORT)[1]} r="4" fill="#0b1730"></circle>
      <text x={project(AIRPORT)[0] - 8} y={project(AIRPORT)[1] + 3} font-size="9" text-anchor="end" fill="#0b1730">
        Airport
      </text>
    </g>
  </svg>
  <figcaption class="sr-only">Route: airport, {stops.map((s) => s.title).join(', ')}, airport.</figcaption>
</figure>

<style>
  .route-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .route-line {
        stroke-dashoffset: 1;
        animation: draw linear forwards;
      }
      /* Separate rule so the minifier can't fold the timeline into the shorthand (browsers reject that). */
      figure .route-line {
        animation-timeline: view();
        animation-range: entry 10% cover 50%;
      }
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
