---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Every raster image goes through <Picture> (AVIF + WebP, responsive srcset — docs/09 §2).
// Until real photography exists, a labelled gradient placeholder is rendered instead.
interface Props {
  image?: ImageMetadata | null;
  alt?: string | null;
  tone?: 'ocean' | 'tea' | 'heritage' | 'wild' | 'sand';
  label?: string;
  class?: string;
  /** LCP image: eager + high priority. */
  priority?: boolean;
  sizes?: string;
}

const {
  image,
  alt = '',
  tone = 'ocean',
  label = 'Photo placeholder',
  class: className,
  priority = false,
  sizes = '(min-width: 1024px) 33vw, 100vw',
} = Astro.props;
---

{image ? (
  <Picture
    src={image}
    alt={alt ?? ''}
    formats={['avif', 'webp']}
    quality={45}
    widths={[400, 640, 800, 960, 1280, 1600, 2000].filter((w) => w <= image.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class:list={['h-full w-full object-cover', className]}
  />
) : (
  <div class:list={['ph', `ph-${tone}`, 'h-full w-full', className]} aria-hidden="true">
    <span class="ph-label">{label}</span>
  </div>
)}
