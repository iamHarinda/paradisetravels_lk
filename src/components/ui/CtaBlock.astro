---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Media from './Media.astro';
import { whatsappLink } from '../../lib/site';
import { photo, type PhotoName } from '../../lib/photos';
import { langFromPath } from '../../lib/i18n';

interface Props {
  title?: string;
  text?: string;
  tone?: 'ocean' | 'tea' | 'heritage' | 'wild';
  photoName?: PhotoName;
}
const ko = langFromPath(Astro.url.pathname) === 'ko';
const {
  title = ko ? '꿈꾸던 스리랑카 여행을 들려주세요.' : 'Tell us your dream trip.',
  text = ko ? '영업이 아닌, 실제 여행 계획으로 답변 드립니다.' : 'We reply with a plan — not a sales pitch.',
  tone = 'heritage',
  photoName,
} = Astro.props;
// Background photo follows the page's tone unless one is given.
const TONE_PHOTO: Record<string, PhotoName> = {
  ocean: 'mirissa',
  tea: 'misty-hills',
  heritage: 'sigiriya-gardens',
  wild: 'minneriya',
};
const bg = photo(photoName ?? TONE_PHOTO[tone] ?? 'misty-hills');
const page = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
---

<section class="relative isolate overflow-hidden py-24 text-center text-white sm:py-32">
  <div class="absolute inset-0 -z-10">
    <Media image={bg.image} alt="" tone={tone} sizes="100vw" />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(5_15_36/0.55),rgb(5_15_36/0.75))]"></div>
  </div>
  <div class="container-site max-w-2xl">
    <h2 class="reveal text-h2">{title}</h2>
    <p class="reveal mt-4 text-lg text-white/90">{text}</p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-3">
      <Button href={ko ? '/ko/contact' : '/plan-your-trip'} size="lg">
        {ko ? '여행 상담' : 'Plan My Trip'}
      </Button>
      <Button
        href={whatsappLink(ko ? '안녕하세요, 스리랑카 여행 상담을 받고 싶습니다.' : undefined, page)}
        variant="light"
        size="lg"
        rel="noopener"
        data-track="whatsapp"
      >
        <Icon name="whatsapp" /> {ko ? '왓츠앱' : 'WhatsApp'}
      </Button>
    </div>
  </div>
</section>
