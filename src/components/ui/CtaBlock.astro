---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Media from './Media.astro';
import { whatsappLink } from '../../lib/site';

interface Props {
  title?: string;
  text?: string;
  tone?: 'ocean' | 'tea' | 'heritage' | 'wild';
}
const {
  title = 'Tell us your dream trip.',
  text = 'We reply with a plan — not a sales pitch.',
  tone = 'heritage',
} = Astro.props;
const page = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
---

<section class="relative isolate overflow-hidden py-24 text-center text-white sm:py-32">
  <div class="absolute inset-0 -z-10">
    <Media tone={tone} />
    <div class="absolute inset-0 bg-ocean-900/50"></div>
  </div>
  <div class="container-site max-w-2xl">
    <h2 class="reveal text-h2">{title}</h2>
    <p class="reveal mt-4 text-lg text-white/90">{text}</p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/plan-your-trip" size="lg">
        Plan My Trip
      </Button>
      <Button href={whatsappLink(undefined, page)} variant="light" size="lg" rel="noopener" data-track="whatsapp">
        <Icon name="whatsapp" /> WhatsApp
      </Button>
    </div>
  </div>
</section>
