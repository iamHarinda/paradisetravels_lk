---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['divide-y divide-line border-y border-line', className]}>
  {items.map((item) => (
    <details class="group py-1">
      <summary class="flex min-h-14 list-none items-center justify-between gap-6 py-3 text-left font-semibold [&::-webkit-details-marker]:hidden">
        {item.q}
        <Icon name="chevron" class="size-5 shrink-0 transition-transform duration-200 group-open:rotate-180" />
      </summary>
      <p class="pb-5 text-muted">{item.a}</p>
    </details>
  ))}
</div>
