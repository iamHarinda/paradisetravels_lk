---
import { getEntries } from '../../lib/content';
import Media from './Media.astro';
import type { Lang } from '../../lib/i18n';

// The Chairman & MD with his photo (supplied by the owner, October 2026). Used on About (EN/KO) and the home page.
// Draft bios with {{TODO}} are never shown.
interface Props {
  lang?: Lang;
  class?: string;
}
const { lang = 'en', class: className } = Astro.props;
const leader = (await getEntries('team')).find((t) => t.data.order === 1);
const ko = lang === 'ko';
const bio = leader?.data.bio && !leader.data.bio.includes('{{TODO') ? leader.data.bio : null;
---

{leader && (
  <figure
    class:list={[
      'grid overflow-hidden rounded-media bg-surface shadow-card ring-1 ring-line sm:grid-cols-[minmax(0,14rem)_1fr]',
      className,
    ]}
  >
    <div class="relative aspect-[4/5] bg-ocean-900 sm:aspect-auto sm:min-h-72">
      {leader.data.photo ? (
        <Media
          image={leader.data.photo}
          alt={ko ? `${leader.data.name} 대표` : `${leader.data.name}, ${leader.data.role}`}
          class="absolute inset-0 object-[50%_20%]"
          sizes="(min-width: 640px) 14rem, 92vw"
        />
      ) : (
        <span class="absolute inset-0 grid place-items-center font-display text-4xl text-gold-300" aria-hidden="true">
          {leader.data.name
            .split(' ')
            .map((n) => n[0])
            .join('')}
        </span>
      )}
    </div>
    <figcaption class="flex flex-col justify-center p-6 sm:p-8">
      <p class="detail text-gold-700 dark:text-gold-400">{ko ? '대표 이사' : leader.data.role}</p>
      <p class="mt-2 font-display text-3xl leading-tight" lang="en">
        {leader.data.name}
      </p>
      {ko ? (
        <p class="mt-3 text-muted">
          30년 넘게 한국과 인연을 이어 온 한국 전문가로, 한국어에 능통합니다. 파라다이스 트래블스는 대표가 직접 운영하는
          가족 경영 여행사로, 한국어로 편하게 상담하실 수 있습니다.
        </p>
      ) : (
        <p class="mt-3 text-muted">
          {bio ??
            'Paradise Travels is a family business, personally run. When you plan with us, you plan with the people who answer the phone.'}
        </p>
      )}
    </figcaption>
  </figure>
)}
