---
import { AIRLINES } from '../../data/airlines';

// Airline tiles (CLAUDE.md: only airlines the owner confirmed). Full-colour logos — the owner wants them visible —
// with the IATA code as a gold "boarding-pass" chip. An airline without a free logo file shows its name as a
// wordmark until the official artwork is supplied (docs/CONTENT-TODO.md).
interface Props {
  class?: string;
  /** "dark" = tiles sit on a navy section. */
  tone?: 'light' | 'dark';
}
const { class: className, tone = 'light' } = Astro.props;
---

<ul class:list={['grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6', className]}>
  {AIRLINES.map((a, i) => (
    <li
      class:list={[
        'airline reveal group relative flex h-28 flex-col items-center justify-center gap-2 overflow-hidden rounded-card bg-white px-4 text-center',
        tone === 'dark' ? 'ring-1 ring-white/10' : 'ring-1 ring-black/5 shadow-card',
      ]}
      style={`transition-delay:${(i % 6) * 60}ms`}
    >
      <span class="absolute top-2 right-2 rounded-md bg-gold-100 px-1.5 py-0.5 font-mono text-[0.68rem] font-bold tracking-wider text-gold-700 ring-1 ring-gold-300">
        {a.iata}
      </span>
      {a.logo ? (
        <img
          src={a.logo}
          alt=""
          width="160"
          height="48"
          loading="lazy"
          decoding="async"
          class="w-auto max-w-[80%] object-contain transition-transform duration-300 ease-travel group-hover:scale-105"
          style={`height: ${2.1 * (a.scale ?? 1)}rem`}
        />
      ) : (
        <span class="font-display text-2xl leading-tight font-semibold text-ocean-900">{a.name}</span>
      )}
      {a.logo && <span class="text-xs font-semibold text-[#4d5b75]">{a.name}</span>}
    </li>
  ))}
</ul>
