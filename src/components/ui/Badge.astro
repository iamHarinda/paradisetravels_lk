---
interface Props {
  tone?: 'gold' | 'light' | 'ocean';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
const tones = {
  gold: 'bg-gold-500 text-ocean-900',
  light: 'bg-white/90 text-ocean-900',
  ocean: 'bg-ocean-900 text-white',
};
---

<span class:list={['inline-flex items-center rounded-pill px-3 py-1 text-xs font-bold', tones[tone], className]}>
  <slot />
</span>
