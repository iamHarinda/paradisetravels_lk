---
import Accordion from './Accordion.astro';

interface Props {
  faqs: { q: string; a: string }[];
  title?: string;
}
const { faqs, title = 'Frequently asked questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="container-site py-16" aria-labelledby="faq-heading">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <h2 id="faq-heading" class="text-h2">
        {title}
      </h2>
      <Accordion items={faqs} />
    </div>
  </section>
)}
