---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';
import { accent } from '../../lib/text';

// Immersive inner-page hero: a large, rounded photograph (the LCP) with the headline set over a navy wash.
// Used where the photo is the point — tour types, hotels, the tours hub.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Small caption in the corner, e.g. the place in the photo. */
  caption?: string;
}
const { eyebrow, title, intro, image, imageAlt, caption } = Astro.props;
---

<section class="container-site pt-4 sm:pt-6">
  <div class="relative isolate flex min-h-[68svh] flex-col justify-end overflow-hidden rounded-media p-6 text-white shadow-[var(--shadow-lift)] sm:min-h-[72svh] sm:p-12 lg:p-16">
    <Media
      image={image}
      alt={imageAlt}
      priority
      class="photo-hero-img absolute inset-0 -z-20"
      sizes="(min-width: 1440px) 1360px, (min-width: 640px) calc(100vw - 5rem), calc(100vw - 2rem)"
    />
    <span
      class="absolute inset-0 -z-10 bg-[linear-gradient(15deg,rgb(5_15_36/0.9)_5%,rgb(5_15_36/0.35)_55%,rgb(5_15_36/0.05))]"
      aria-hidden="true"
    ></span>
    <div class="max-w-4xl">
      {eyebrow && (
        <p class="chapter text-gold-300!">
          <span class="chapter-rule" aria-hidden="true" />
          <span>{eyebrow}</span>
        </p>
      )}
      <h1
        class="photo-hero-title mt-4 text-[clamp(2.75rem,6vw+1rem,6.5rem)] leading-[0.98] tracking-[-0.03em]"
        set:html={accent(title)}
      />
      {intro && <p class="mt-6 max-w-[58ch] text-lg text-white/90 sm:text-xl">{intro}</p>}
      <slot />
    </div>
    {caption && <p class="absolute top-5 right-6 text-xs text-white/75">{caption}</p>}
  </div>
</section>

<style>
  .photo-hero-title :global(.accent) {
    color: var(--c-gold-400);
  }
  :global(.photo-hero-img) {
    animation: settle 2.4s var(--ease-travel) both;
  }
  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.photo-hero-img) {
      animation: none;
    }
  }
</style>
