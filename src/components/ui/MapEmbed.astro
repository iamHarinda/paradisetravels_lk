---
import Icon from './Icon.astro';
import { SITE } from '../../lib/site';
import type { Lang } from '../../lib/i18n';

// Google Maps "facade" (CLAUDE.md hard rule 8): a static card until the visitor asks for the map, so Google's
// scripts and cookies never load on page view. The iframe is keyless (output=embed) and points at our listing.
interface Props {
  lang?: Lang;
  class?: string;
}
const { lang = 'en', class: className } = Astro.props;
const ko = lang === 'ko';
---

<div
  class:list={['map-embed relative aspect-[4/3] overflow-hidden rounded-media bg-sky-100 ring-1 ring-line', className]}
  data-map-embed={SITE.mapsEmbed}
  data-map-title={ko ? '파라다이스 트래블스 위치 (구글 지도)' : 'Paradise Travels on Google Maps'}
>
  <div class="absolute inset-0 grid place-items-center p-6 text-center">
    <div>
      <Icon name="googlemaps" class="mx-auto size-10 text-[#4285F4]" />
      <p class="mt-3 font-semibold text-ink-900" lang={ko ? 'en' : undefined}>
        {SITE.addressLine}
      </p>
      <button
        type="button"
        class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-pill bg-ocean-900 px-5 text-sm font-semibold text-white hover:bg-ocean-700"
        data-map-load
      >
        <Icon name="pin" class="size-4" />
        {ko ? '지도 보기' : 'Show map'}
      </button>
      <p class="mt-2 text-xs text-muted">{ko ? '구글 지도가 로드됩니다.' : 'Loads Google Maps.'}</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map-embed]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.dataset.mapEmbed!;
      frame.title = box.dataset.mapTitle!;
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.className = 'absolute inset-0 h-full w-full border-0';
      box.replaceChildren(frame);
    });
  });
</script>
