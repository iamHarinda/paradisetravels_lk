---
import WhereSearch from '../forms/WhereSearch.astro';
import { SITE } from '../../lib/site';
import { REGIONS, MONTHS_LONG, type RegionId } from '../../lib/seasons';
import { AIRLINES } from '../../data/airlines';
import { getEntries } from '../../lib/content';

// Signature hero: light sky with a live dotted globe (canvas) showing flight arcs from Colombo, and a
// kinetic headline. The headline text is the LCP (fast); the globe script is ~6 KB and never blocks rendering.
const seasons = Object.fromEntries(Object.entries(REGIONS).map(([id, r]) => [id, r.bestMonths]));
const inSeason = (month: number) =>
  (Object.keys(REGIONS) as RegionId[]).filter((r) => (REGIONS[r].bestMonths as readonly number[]).includes(month));
const buildMonth = new Date().getMonth() + 1;
const buildRegions = inSeason(buildMonth);
const destinations = await getEntries('destinations');

// Only verifiable numbers (CLAUDE.md hard rule 1).
const facts = [
  { value: String(SITE.foundingYear), label: 'Since' },
  { value: String(AIRLINES.length), label: 'Airlines ticketed' },
  { value: String(destinations.length), label: 'Destinations' },
];
---

<section class="hero relative isolate -mt-20 overflow-hidden pt-20">
  <div class="hero-sky pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-site grid min-h-[calc(100svh-5rem)] items-center gap-6 py-12 lg:grid-cols-[1fr_1.05fr] lg:py-16">
    <div class="relative z-10">
      <p class="detail flex flex-wrap gap-x-4 gap-y-1 text-ocean-500">
        <span>7.87°N 80.77°E</span>
        <span aria-hidden="true">/</span>
        <span>Colombo · since {SITE.foundingYear}</span>
      </p>
      <h1 class="kinetic mt-6 text-[clamp(3.25rem,7vw+1rem,7.75rem)] leading-[0.95] tracking-[-0.035em]">
        <span class="line">
          <span style="--i:0">Sri Lanka,</span>
        </span>
        <span class="line">
          <em class="accent gradient-text" style="--i:1">
            planned
          </em>
        </span>
        <span class="line">
          <span style="--i:2">end-to-end.</span>
        </span>
      </h1>
      <p class="fade-up mt-8 max-w-[50ch] text-lg text-muted" style="--i:3">
        Flights on {AIRLINES.length} airlines, visas, handpicked hotels at partner rates, private drivers, expert guides
        and Ayurveda retreats — arranged by one Colombo team.
      </p>
      <WhereSearch id="hero-where" class="fade-up mt-8" style="--i:4" />
      <p
        class="fade-up mt-6 flex items-start gap-3 text-sm text-muted"
        style="--i:5"
        data-in-season
        data-seasons={JSON.stringify(seasons)}
      >
        <span class="relative mt-1.5 flex size-2.5 shrink-0" aria-hidden="true">
          <span class="absolute inset-0 animate-ping rounded-full bg-tea-600 opacity-50 motion-reduce:hidden"></span>
          <span class="relative size-2.5 rounded-full bg-tea-600"></span>
        </span>
        <span data-in-season-text>
          {buildRegions.length ? (
            <>
              <strong class="text-ink-900">In season in {MONTHS_LONG[buildMonth - 1]}:</strong>{' '}
              {buildRegions.map((r) => REGIONS[r].name).join(', ')}
            </>
          ) : (
            <>
              <strong class="text-ink-900">{MONTHS_LONG[buildMonth - 1]} is shoulder season</strong> — ask us where the
              weather is best.
            </>
          )}
        </span>
      </p>
      <dl class="fade-up mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-line pt-6" style="--i:6">
        {facts.map((f) => (
          <div class="flex flex-col-reverse">
            <dt class="detail mt-1 text-muted">{f.label}</dt>
            <dd class="font-display text-4xl leading-none text-ocean-700">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="globe-wrap relative mx-auto aspect-square w-full max-w-[44rem] lg:-mr-10">
      <canvas class="absolute inset-0 h-full w-full" data-globe aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<style>
  /* Kinetic headline: each line rises out of its own mask. */
  .kinetic .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .kinetic .line > * {
    display: block;
    animation: rise 1s cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(var(--i) * 110ms + 80ms);
  }
  .fade-up {
    animation: fade-up 900ms cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(var(--i) * 110ms + 80ms);
  }
  .gradient-text {
    background: linear-gradient(100deg, #1e63d6 10%, #60a5fa 50%, #1e63d6 90%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      rise 1s cubic-bezier(0.2, 0.75, 0.15, 1) both,
      shimmer 6s ease-in-out 1.2s infinite;
    animation-delay: calc(var(--i) * 110ms + 80ms), 1.2s;
  }
  /* Light sky: soft blue light sources over the page background. */
  .hero-sky {
    background:
      radial-gradient(52rem 36rem at 78% 45%, rgb(30 99 214 / 0.14), transparent 70%),
      radial-gradient(40rem 28rem at 8% 0%, rgb(147 197 253 / 0.35), transparent 70%),
      linear-gradient(180deg, #eaf3fe 0%, var(--c-bg) 100%);
  }
  /* Feather the canvas edges so the globe blends into the page — no visible square. */
  .globe-wrap canvas {
    mask-image: radial-gradient(closest-side, #000 88%, transparent 100%);
  }
  .globe-wrap {
    animation: globe-in 1.6s cubic-bezier(0.2, 0.75, 0.15, 1) 0.2s both;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes shimmer {
    50% {
      background-position: 100% 0;
    }
  }
  @keyframes globe-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kinetic .line > *,
    .fade-up,
    .gradient-text,
    .globe-wrap {
      animation: none;
    }
  }
</style>

<script>
  import { MONTHS_LONG, REGIONS, type RegionId } from '../../lib/seasons';
  import { mountGlobe } from '../../scripts/globe';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  if (canvas) mountGlobe(canvas);

  // "In season" line follows the visitor's current month (the HTML has the build month as a fallback).
  const el = document.querySelector<HTMLElement>('[data-in-season]');
  const text = el?.querySelector('[data-in-season-text]');
  if (el && text) {
    const seasons = JSON.parse(el.dataset.seasons!) as Record<RegionId, number[]>;
    const m = new Date().getMonth() + 1;
    const regions = (Object.keys(seasons) as RegionId[]).filter((r) => seasons[r].includes(m));
    const strong = document.createElement('strong');
    strong.className = 'text-ink-900';
    if (regions.length) {
      strong.textContent = `In season in ${MONTHS_LONG[m - 1]}:`;
      text.replaceChildren(strong, ` ${regions.map((r) => REGIONS[r].name).join(', ')}`);
    } else {
      strong.textContent = `${MONTHS_LONG[m - 1]} is shoulder season`;
      text.replaceChildren(strong, ' — ask us where the weather is best.');
    }
  }
</script>
