---
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
import { SITE } from '../../lib/site';
import { photo } from '../../lib/photos';
import { REGIONS, MONTHS_LONG, type RegionId } from '../../lib/seasons';

// Editorial hero (docs/04 §5.1, "Editorial + tickets" direction): giant headline with an italic accent,
// a three-photo collage with coordinate captions and a live "in season now" line. The main photo is the LCP.
const main = photo('sigiriya-view');
const second = photo('ella-train');
const third = photo('mirissa');

const seasons = Object.fromEntries(Object.entries(REGIONS).map(([id, r]) => [id, r.bestMonths]));
const inSeason = (month: number) =>
  (Object.keys(REGIONS) as RegionId[]).filter((r) => (REGIONS[r].bestMonths as readonly number[]).includes(month));
const buildMonth = new Date().getMonth() + 1;
const buildRegions = inSeason(buildMonth);
---

<section class="relative overflow-hidden pt-10 pb-16 sm:pt-14 lg:pb-24">
  <div class="container-site grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <p class="detail flex flex-wrap gap-x-4 gap-y-1 text-muted">
        <span>7.87°N 80.77°E</span>
        <span aria-hidden="true">/</span>
        <span>Colombo since {SITE.foundingYear}</span>
      </p>
      <!-- Fixed line breaks: the italic accent font swapping in can't re-wrap the headline (no CLS). -->
      <h1 class="mt-6 text-[clamp(3rem,7.5vw+1rem,7.5rem)] leading-[0.95] tracking-[-0.03em]">
        <span class="block">Sri Lanka,</span>
        <em class="accent block">planned</em>
        <span class="block">end-to-end.</span>
      </h1>
      <p class="mt-8 max-w-[52ch] text-lg text-muted">
        Flights, visas, handpicked hotels at partner rates, private drivers, expert guides and Ayurveda retreats —
        arranged by one Colombo team.
      </p>
      <form
        class="mt-8 flex max-w-xl items-center gap-2 rounded-pill bg-surface p-2 shadow-[0_20px_50px_-30px_rgb(7_26_51/0.6)] ring-1 ring-line shadow-card"
        action="/plan-your-trip"
        method="get"
      >
        <label class="sr-only" for="hero-where">
          Where do you want to go?
        </label>
        <input
          id="hero-where"
          name="where"
          class="min-h-12 min-w-0 flex-1 rounded-pill bg-transparent px-4 outline-none placeholder:text-muted"
          placeholder="Where do you want to go?"
          autocomplete="off"
        />
        <Button type="submit" class="shrink-0">
          <span class="sm:hidden">Plan</span>
          <span class="hidden sm:inline">Start planning</span>
        </Button>
      </form>
      <p class="mt-6 flex items-start gap-3 text-sm" data-in-season data-seasons={JSON.stringify(seasons)}>
        <span class="relative mt-1.5 flex size-2.5 shrink-0" aria-hidden="true">
          <span class="absolute inset-0 animate-ping rounded-full bg-tea-600 opacity-60 motion-reduce:hidden"></span>
          <span class="relative size-2.5 rounded-full bg-tea-600"></span>
        </span>
        <span data-in-season-text>
          {buildRegions.length ? (
            <>
              <strong>In season in {MONTHS_LONG[buildMonth - 1]}:</strong>{' '}
              {buildRegions.map((r) => REGIONS[r].name).join(', ')}
            </>
          ) : (
            <>
              <strong>{MONTHS_LONG[buildMonth - 1]} is shoulder season</strong> — ask us where the weather is best.
            </>
          )}
        </span>
      </p>
    </div>

    <div class="relative grid grid-cols-[1fr_0.55fr] grid-rows-[auto_auto] gap-3 sm:gap-4">
      <div
        class="pointer-events-none absolute -inset-16 -z-10 rounded-full bg-[radial-gradient(closest-side,rgb(30_99_214/0.18),transparent)]"
        aria-hidden="true"
      ></div>
      <figure class="relative row-span-2 min-h-72 overflow-hidden rounded-media shadow-[var(--shadow-lift)]">
        <div class="absolute inset-0">
          <Media image={main.image} alt={main.alt} priority sizes="(min-width: 1024px) 34vw, 62vw" />
        </div>
        <figcaption class="detail absolute top-0 left-0 p-4 text-white [text-shadow:0_1px_8px_rgb(0_0_0/0.5)]">
          Sigiriya · 7.96°N
        </figcaption>
      </figure>
      <figure class="relative mt-10 overflow-hidden rounded-media shadow-card">
        <div class="aspect-[3/4]">
          <Media image={second.image} alt={second.alt} sizes="(min-width: 1024px) 18vw, 34vw" />
        </div>
        <figcaption class="detail absolute bottom-0 left-0 p-3 text-white [text-shadow:0_1px_8px_rgb(0_0_0/0.5)]">
          Ella
        </figcaption>
      </figure>
      <figure class="relative overflow-hidden rounded-media shadow-card">
        <div class="aspect-square">
          <Media image={third.image} alt={third.alt} sizes="(min-width: 1024px) 18vw, 34vw" />
        </div>
        <figcaption class="detail absolute bottom-0 left-0 p-3 text-white [text-shadow:0_1px_8px_rgb(0_0_0/0.5)]">
          Mirissa
        </figcaption>
      </figure>
      <div
        class="absolute -bottom-6 -left-6 hidden rounded-card bg-ocean-900/90 px-5 py-4 text-white shadow-[var(--shadow-lift)] ring-1 ring-white/10 backdrop-blur sm:block"
        aria-hidden="true"
      >
        <p class="detail text-lagoon-300">Since</p>
        <p class="font-display text-4xl leading-none">{SITE.foundingYear}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { MONTHS_LONG, REGIONS, type RegionId } from '../../lib/seasons';

  // Update the "in season" line to the visitor's current month (the HTML has the build month as a fallback).
  const el = document.querySelector<HTMLElement>('[data-in-season]');
  const text = el?.querySelector('[data-in-season-text]');
  if (el && text) {
    const seasons = JSON.parse(el.dataset.seasons!) as Record<RegionId, number[]>;
    const m = new Date().getMonth() + 1;
    const regions = (Object.keys(seasons) as RegionId[]).filter((r) => seasons[r].includes(m));
    const strong = document.createElement('strong');
    if (regions.length) {
      strong.textContent = `In season in ${MONTHS_LONG[m - 1]}:`;
      text.replaceChildren(strong, ` ${regions.map((r) => REGIONS[r].name).join(', ')}`);
    } else {
      strong.textContent = `${MONTHS_LONG[m - 1]} is shoulder season`;
      text.replaceChildren(strong, ' — ask us where the weather is best.');
    }
  }
</script>
