---
import Button from '../ui/Button.astro';
import { SITE } from '../../lib/site';
import { REGIONS, MONTHS_LONG, type RegionId } from '../../lib/seasons';
import { AIRLINES } from '../../data/airlines';
import { getEntries } from '../../lib/content';

// Signature hero: full-screen navy with a live dotted globe (canvas) showing flight arcs from Colombo, and a
// kinetic headline. The headline text is the LCP (fast); the globe script is ~6 KB and never blocks rendering.
const seasons = Object.fromEntries(Object.entries(REGIONS).map(([id, r]) => [id, r.bestMonths]));
const inSeason = (month: number) =>
  (Object.keys(REGIONS) as RegionId[]).filter((r) => (REGIONS[r].bestMonths as readonly number[]).includes(month));
const buildMonth = new Date().getMonth() + 1;
const buildRegions = inSeason(buildMonth);
const destinations = await getEntries('destinations');

// Only verifiable numbers (CLAUDE.md hard rule 1).
const facts = [
  { value: String(SITE.foundingYear), label: 'Since' },
  { value: String(AIRLINES.length), label: 'Airlines ticketed' },
  { value: String(destinations.length), label: 'Destinations' },
];
---

<section class="on-dark hero relative isolate -mt-20 overflow-hidden bg-ocean-900 pt-20 text-white">
  <div class="container-site grid min-h-[calc(100svh-5rem)] items-center gap-6 py-12 lg:grid-cols-[1fr_1.05fr] lg:py-16">
    <div class="relative z-10">
      <p class="detail flex flex-wrap gap-x-4 gap-y-1 text-lagoon-300">
        <span>7.87°N 80.77°E</span>
        <span aria-hidden="true">/</span>
        <span>Colombo · since {SITE.foundingYear}</span>
      </p>
      <h1 class="kinetic mt-6 text-[clamp(3.25rem,7vw+1rem,7.75rem)] leading-[0.95] tracking-[-0.035em]">
        <span class="line">
          <span style="--i:0">Sri Lanka,</span>
        </span>
        <span class="line">
          <em class="accent gradient-text" style="--i:1">
            planned
          </em>
        </span>
        <span class="line">
          <span style="--i:2">end-to-end.</span>
        </span>
      </h1>
      <p class="fade-up mt-8 max-w-[50ch] text-lg text-white/80" style="--i:3">
        Flights on {AIRLINES.length} airlines, visas, handpicked hotels at partner rates, private drivers, expert guides
        and Ayurveda retreats — arranged by one Colombo team.
      </p>
      <form
        class="fade-up mt-8 flex max-w-xl items-center gap-2 rounded-pill bg-white/10 p-2 ring-1 ring-white/20 backdrop-blur-md"
        style="--i:4"
        action="/plan-your-trip"
        method="get"
      >
        <label class="sr-only" for="hero-where">
          Where do you want to go?
        </label>
        <input
          id="hero-where"
          name="where"
          class="min-h-12 min-w-0 flex-1 rounded-pill bg-transparent px-4 text-white outline-none placeholder:text-white/60"
          placeholder="Where do you want to go?"
          autocomplete="off"
        />
        <Button type="submit" class="shrink-0">
          <span class="sm:hidden">Plan</span>
          <span class="hidden sm:inline">Start planning</span>
        </Button>
      </form>
      <p
        class="fade-up mt-6 flex items-start gap-3 text-sm text-white/85"
        style="--i:5"
        data-in-season
        data-seasons={JSON.stringify(seasons)}
      >
        <span class="relative mt-1.5 flex size-2.5 shrink-0" aria-hidden="true">
          <span class="absolute inset-0 animate-ping rounded-full bg-emerald-400 opacity-60 motion-reduce:hidden"></span>
          <span class="relative size-2.5 rounded-full bg-emerald-400"></span>
        </span>
        <span data-in-season-text>
          {buildRegions.length ? (
            <>
              <strong class="text-white">In season in {MONTHS_LONG[buildMonth - 1]}:</strong>{' '}
              {buildRegions.map((r) => REGIONS[r].name).join(', ')}
            </>
          ) : (
            <>
              <strong class="text-white">{MONTHS_LONG[buildMonth - 1]} is shoulder season</strong> — ask us where the
              weather is best.
            </>
          )}
        </span>
      </p>
      <dl class="fade-up mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-white/15 pt-6" style="--i:6">
        {facts.map((f) => (
          <div class="flex flex-col-reverse">
            <dt class="detail mt-1 text-white/60">{f.label}</dt>
            <dd class="font-display text-4xl leading-none">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="globe-wrap relative mx-auto aspect-square w-full max-w-[44rem] lg:-mr-10">
      <canvas
        class="absolute inset-0 h-full w-full cursor-grab touch-pan-y active:cursor-grabbing"
        data-globe
        aria-hidden="true"
      ></canvas>
      <p class="detail pointer-events-none absolute bottom-2 left-4 text-white/50 max-lg:hidden">Drag to spin</p>
    </div>
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-[linear-gradient(transparent,rgb(7_26_51/0.6))]"
    aria-hidden="true"
  ></div>
</section>

<style>
  /* Kinetic headline: each line rises out of its own mask. */
  .kinetic .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .kinetic .line > * {
    display: block;
    animation: rise 1s cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(var(--i) * 110ms + 80ms);
  }
  .fade-up {
    animation: fade-up 900ms cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(var(--i) * 110ms + 80ms);
  }
  .gradient-text {
    background: linear-gradient(100deg, #93c5fd 10%, #ffffff 55%, #93c5fd 90%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      rise 1s cubic-bezier(0.2, 0.75, 0.15, 1) both,
      shimmer 6s ease-in-out 1.2s infinite;
    animation-delay: calc(var(--i) * 110ms + 80ms), 1.2s;
  }
  .globe-wrap {
    animation: globe-in 1.6s cubic-bezier(0.2, 0.75, 0.15, 1) 0.2s both;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes shimmer {
    50% {
      background-position: 100% 0;
    }
  }
  @keyframes globe-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kinetic .line > *,
    .fade-up,
    .gradient-text,
    .globe-wrap {
      animation: none;
    }
  }
</style>

<script>
  import { MONTHS_LONG, REGIONS, type RegionId } from '../../lib/seasons';
  import { mountGlobe } from '../../scripts/globe';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  if (canvas) mountGlobe(canvas);

  // "In season" line follows the visitor's current month (the HTML has the build month as a fallback).
  const el = document.querySelector<HTMLElement>('[data-in-season]');
  const text = el?.querySelector('[data-in-season-text]');
  if (el && text) {
    const seasons = JSON.parse(el.dataset.seasons!) as Record<RegionId, number[]>;
    const m = new Date().getMonth() + 1;
    const regions = (Object.keys(seasons) as RegionId[]).filter((r) => seasons[r].includes(m));
    const strong = document.createElement('strong');
    strong.className = 'text-white';
    if (regions.length) {
      strong.textContent = `In season in ${MONTHS_LONG[m - 1]}:`;
      text.replaceChildren(strong, ` ${regions.map((r) => REGIONS[r].name).join(', ')}`);
    } else {
      strong.textContent = `${MONTHS_LONG[m - 1]} is shoulder season`;
      text.replaceChildren(strong, ' — ask us where the weather is best.');
    }
  }
</script>
