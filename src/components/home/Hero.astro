---
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
import { SITE } from '../../lib/site';
import { photo } from '../../lib/photos';

const hero = photo('sigiriya-view');

// Cinematic hero (docs/04 §5.1). The poster image is the LCP element; the video is added once footage exists
// (≤ 1.5 MB, muted, preload="none", started after load — docs/09 §3).
---

<section class="relative isolate flex min-h-[100svh] items-end overflow-hidden pt-32 pb-16 text-white sm:pb-20">
  <div class="absolute inset-0 -z-10">
    <Media image={hero.image} alt={hero.alt} priority sizes="100vw" />
    <div class="absolute inset-0 bg-ocean-900/45"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(6_42_53/0.55)_0%,transparent_35%,rgb(6_42_53/0.35)_60%,rgb(6_42_53/0.85)_100%)]"></div>
  </div>
  <div class="container-site">
    <p class="mb-5 text-sm font-semibold tracking-[0.2em] text-gold-300 uppercase">
      Since {SITE.foundingYear} · Colombo
    </p>
    <h1 class="max-w-[12ch] text-h1 [text-shadow:0_2px_24px_rgb(6_42_53/0.45)]">Sri Lanka, planned end-to-end.</h1>
    <p class="mt-6 max-w-[56ch] text-lg text-white/90">
      Flights, visas, handpicked hotels at partner rates, private drivers, expert guides and Ayurveda retreats —
      arranged by one Colombo team that has been doing this since {SITE.foundingYear}.
    </p>
    <form
      class="mt-8 flex max-w-xl items-center gap-2 rounded-pill bg-white p-2 shadow-2xl"
      action="/plan-your-trip"
      method="get"
    >
      <label class="sr-only" for="hero-where">
        Where do you want to go?
      </label>
      <input
        id="hero-where"
        name="where"
        class="min-h-12 min-w-0 flex-1 rounded-pill px-4 text-ink-900 outline-none placeholder:text-[#6b6862]"
        placeholder="Where do you want to go?"
        autocomplete="off"
      />
      <Button type="submit" class="shrink-0">
        <span class="sm:hidden">Plan</span>
        <span class="hidden sm:inline">Start planning</span>
      </Button>
    </form>
    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/85">
      <li>✦ Since {SITE.foundingYear}</li>
      <li>✦ Replies on WhatsApp</li>
      <li>✦ Based in Colombo</li>
      <li>✦ Flights · hotels · drivers · guides</li>
    </ul>
  </div>
</section>
