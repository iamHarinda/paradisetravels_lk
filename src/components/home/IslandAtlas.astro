---
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';
import { OUTLINE, project, AIRPORT } from '../../lib/geo';
import { photo } from '../../lib/photos';
import { HIGHLIGHTS, HIGHLIGHT_CATEGORIES, CATEGORY_META, type HighlightCategory } from '../../data/island-highlights';
import type { Lang } from '../../lib/i18n';
import { PLACE_ICONS } from '../../lib/place-icons';

// "Island Atlas" — an original illustrated map of Sri Lanka (navy ocean, ivory land, gold topography) with every
// highlight pinned at once, each with its own landmark icon (owner: "show everything so a tourist gets the idea at a
// glance"). Themes dim the rest; tap a pin and a postcard with a photo opens alongside.
// Without JS every postcard is listed and the pins link to them. Pins are real <button>s laid over the SVG;
// the same places are also listed as large buttons under the map (WCAG 2.5.8 target-size alternative).
interface Props {
  lang?: Lang;
  index?: string;
}
const { lang = 'en', index = '03' } = Astro.props;

const T = {
  en: {
    eyebrow: 'Our Island',
    title: 'Small island. <em class="accent">Endless discoveries.</em>',
    intro: 'The whole island at a glance. Tap any landmark — every place on this map can be part of your trip.',
    all: 'Everything',
    themes: 'Map themes',
    places: 'Places on the map',
    explore: 'Explore',
    tour: 'See the tour',
    route: 'Classic round trip',
    mapTitle: 'Illustrated map of Sri Lanka with highlights pinned by theme',
  },
  ko: {
    eyebrow: '스리랑카 지도',
    title: '작은 섬, <em class="accent">끝없는 발견.</em>',
    intro: '섬 전체를 한눈에. 명소를 눌러 보세요 — 지도 위 모든 곳을 여행 일정에 넣을 수 있습니다.',
    all: '전체',
    themes: '지도 테마',
    places: '지도 위 장소',
    explore: '자세히 보기',
    tour: '투어 보기',
    route: '대표 일주 코스',
    mapTitle: '테마별 명소가 표시된 스리랑카 일러스트 지도',
  },
}[lang];

const CAT_ICON: Record<HighlightCategory, IconName> = {
  beaches: 'palm',
  heritage: 'stupa',
  wildlife: 'elephant',
  hills: 'leaf',
  'golf-wellness': 'golf',
};

// Map frame (SVG user units) — the island spans roughly x 5…226, y 0…396 (src/lib/geo.ts).
const VB = { x: -34, y: -24, w: 310, h: 492 };
const pctOf = ([x, y]: readonly [number, number]) => ({
  left: ((x - VB.x) / VB.w) * 100,
  top: ((y - VB.y) / VB.h) * 100,
});

const prefix = lang === 'ko' ? '/ko' : '';
// Every pin is shown at once, so neighbours (Sigiriya/Dambulla, the hill towns, the south coast) would overlap.
// Lay them out at build time: each pin + its name label is a box; overlapping boxes are pushed apart while a weak
// spring keeps them near their true place, and a thin leader line joins a moved pin to its real location.
// Units are SVG units; at the desktop map width 1 unit ≈ 1.75 px.
const PIN = 20;
const LABEL_H = 10;
const labelW = (name: string) => (name.length * (lang === 'ko' ? 9.5 : 5.6) + 12) / 1.75;
const boxes = HIGHLIGHTS.map((h) => {
  const [x, y] = project(h.coords);
  const w = Math.max(PIN, labelW(h[lang].name));
  return { ax: x, ay: y, x, y, w, h: PIN + LABEL_H };
});
for (let iter = 0; iter < 400; iter++) {
  for (let i = 0; i < boxes.length; i++) {
    for (let j = i + 1; j < boxes.length; j++) {
      const a = boxes[i]!;
      const b = boxes[j]!;
      // Boxes are anchored at the pin centre: the pin sits at the top, the label hangs below.
      const ox = (a.w + b.w) / 2 + 1.5 - Math.abs(a.x - b.x);
      const oy = PIN / 2 + 1.5 + (a.y < b.y ? a.h - PIN / 2 : b.h - PIN / 2) - Math.abs(a.y - b.y);
      if (ox <= 0 || oy <= 0) continue;
      if (ox < oy) {
        const d = (ox / 2) * (a.x < b.x ? -1 : 1);
        a.x += d;
        b.x -= d;
      } else {
        const d = (oy / 2) * (a.y < b.y ? -1 : 1);
        a.y += d;
        b.y -= d;
      }
    }
  }
  for (const box of boxes) {
    box.x += (box.ax - box.x) * 0.02;
    box.y += (box.ay - box.y) * 0.02;
    // Keep every pin and label inside the map frame (above the "Indian Ocean" lettering).
    box.x = Math.min(Math.max(box.x, VB.x + box.w / 2 + 2), VB.x + VB.w - box.w / 2 - 2);
    box.y = Math.min(Math.max(box.y, VB.y + PIN / 2 + 2), VB.y + VB.h - 34 - (box.h - PIN / 2));
  }
}

const items = HIGHLIGHTS.map((h, i) => {
  const copy = h[lang];
  const href = h.tourType ? `${prefix}/tours/${h.tourType}` : h.destination && `/destinations/${h.destination}`;
  const box = boxes[i]!;
  const moved = Math.hypot(box.x - box.ax, box.y - box.ay) > 4;
  return {
    ...h,
    copy,
    href,
    pos: pctOf([box.x, box.y]),
    pin: [box.x, box.y] as const,
    anchor: [box.ax, box.ay] as const,
    moved,
    img: h.photo ? photo(h.photo) : undefined,
  };
});

// Graticule, topographic rings around the central highlands, and the classic round-trip route.
const lat = (d: number) => project([d, 80])[1];
const lon = (d: number) => project([8, d])[0];
const [hx, hy] = project([7.0, 80.78]);
const rings = [16, 28, 40, 53, 67, 82, 98];
const ROUTE: [number, number][] = [
  [7.209, 79.836], // Negombo
  [7.957, 80.76], // Sigiriya
  [7.294, 80.641], // Kandy
  [6.95, 80.789], // Nuwara Eliya
  [6.876, 81.061], // Ella
  [6.37, 81.4], // Yala
  [5.948, 80.457], // Mirissa
  [6.027, 80.217], // Galle
  [6.927, 79.861], // Colombo
];
const routePts = ROUTE.map((c) => project(c));
// Smooth the route with a Catmull-Rom → cubic Bézier conversion.
const route = routePts
  .map((p, i, a) => {
    if (i === 0) return `M${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
    const p0 = a[i - 2] ?? a[i - 1]!;
    const p1 = a[i - 1]!;
    const p3 = a[i + 1] ?? p;
    const c1 = [p1[0] + (p[0] - p0[0]) / 6, p1[1] + (p[1] - p0[1]) / 6];
    const c2 = [p[0] - (p3[0] - p1[0]) / 6, p[1] - (p3[1] - p1[1]) / 6];
    return `C${c1[0]!.toFixed(1)} ${c1[1]!.toFixed(1)} ${c2[0]!.toFixed(1)} ${c2[1]!.toFixed(1)} ${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
  })
  .join('');
const [ax, ay] = project(AIRPORT);
const DEFAULT_CARD = 'sigiriya';
---

<section
  class="atlas on-dark relative overflow-hidden bg-ocean-900 py-24 text-white"
  aria-labelledby="atlas-heading"
  data-atlas
  data-default={DEFAULT_CARD}
>
  <div class="atlas-grid container-site grid items-start gap-x-16 gap-y-8">
    <!-- Map -->
    <div class="relative [grid-area:map]">
      <div class="atlas-map relative mx-auto w-full max-w-[34rem]" style={`aspect-ratio:${VB.w}/${VB.h}`}>
        <svg
          viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`}
          class="absolute inset-0 h-full w-full"
          role="img"
          aria-labelledby="atlas-map-title"
        >
          <title id="atlas-map-title">{T.mapTitle}</title>
          <defs>
            <linearGradient id="atlas-land" x1="0" y1="0" x2="0.35" y2="1">
              <stop offset="0" stop-color="#fbf4e2"></stop>
              <stop offset="1" stop-color="#efdfb8"></stop>
            </linearGradient>
            <radialGradient id="atlas-hills" cx={hx} cy={hy} r="110" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#c99a3d" stop-opacity="0.32"></stop>
              <stop offset="1" stop-color="#c99a3d" stop-opacity="0"></stop>
            </radialGradient>
            <pattern id="atlas-waves" width="18" height="12" patternUnits="userSpaceOnUse">
              <path
                d="M0 7c3-3 6-3 9 0s6 3 9 0"
                fill="none"
                stroke="#e9c274"
                stroke-opacity="0.13"
                stroke-width="0.8"
              ></path>
            </pattern>
            <clipPath id="atlas-clip">
              <path d={OUTLINE}></path>
            </clipPath>
            <filter id="atlas-shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000" flood-opacity="0.45"></feDropShadow>
            </filter>
          </defs>

          <rect x={VB.x} y={VB.y} width={VB.w} height={VB.h} fill="url(#atlas-waves)"></rect>

          <g class="graticule" stroke="#ffffff" stroke-opacity="0.08" stroke-width="0.6">
            {[6, 7, 8, 9].map((d) => (
              <line x1={VB.x} x2={VB.x + VB.w} y1={lat(d)} y2={lat(d)} />
            ))}
            {[80, 81].map((d) => (
              <line y1={VB.y} y2={VB.y + VB.h} x1={lon(d)} x2={lon(d)} />
            ))}
          </g>
          <g class="graticule-label" fill="#e9c274" fill-opacity="0.55" font-size="7" letter-spacing="1">
            {[6, 7, 8, 9].map((d) => (
              <text x={VB.x + 4} y={lat(d) - 3}>
                {d}°N
              </text>
            ))}
            {[80, 81].map((d) => (
              <text x={lon(d) + 3} y={VB.y + 10}>
                {d}°E
              </text>
            ))}
          </g>

          <text
            x="150"
            y="460"
            text-anchor="middle"
            class="sea-label"
            fill="#ffffff"
            fill-opacity="0.38"
            font-size="11"
            letter-spacing="5"
          >
            INDIAN OCEAN
          </text>
          <text
            x="236"
            y="64"
            text-anchor="middle"
            class="sea-label"
            fill="#ffffff"
            fill-opacity="0.32"
            font-size="8"
            letter-spacing="3"
          >
            <tspan x="236" dy="0">
              BAY OF
            </tspan>
            <tspan x="236" dy="11">
              BENGAL
            </tspan>
          </text>
          <text
            x="-20"
            y="210"
            text-anchor="middle"
            class="sea-label"
            fill="#ffffff"
            fill-opacity="0.3"
            font-size="8"
            letter-spacing="3"
            transform="rotate(-90 -20 210)"
          >
            LACCADIVE SEA
          </text>

          <!-- Island -->
          <path d={OUTLINE} fill="url(#atlas-land)" filter="url(#atlas-shadow)"></path>
          <g clip-path="url(#atlas-clip)">
            <circle cx={hx} cy={hy} r="110" fill="url(#atlas-hills)"></circle>
            {rings.map((r, i) => (
              <ellipse
                cx={hx + i * 1.6}
                cy={hy - i * 2.4}
                rx={r * 0.78}
                ry={r}
                transform={`rotate(-18 ${hx} ${hy})`}
                fill="none"
                stroke="#b8862b"
                stroke-opacity={0.42 - i * 0.045}
                stroke-width="0.7"
              />
            ))}
          </g>
          <path
            class="coast"
            d={OUTLINE}
            fill="none"
            stroke="#d9a94a"
            stroke-width="1.3"
            stroke-linejoin="round"
          ></path>

          <!-- Classic round trip -->
          <path
            class="route"
            d={route}
            fill="none"
            stroke="#0a1f44"
            stroke-opacity="0.55"
            stroke-width="1.2"
            stroke-dasharray="3 3"
            stroke-linecap="round"
          ></path>

          <!-- Leader lines from moved pins to their true location -->
          <g class="leaders">
            {items.map((h) => (
              <g data-cat={h.category} class="leader">
                {h.moved && (
                  <line
                    x1={h.anchor[0]}
                    y1={h.anchor[1]}
                    x2={h.pin[0]}
                    y2={h.pin[1]}
                    stroke="#0a1f44"
                    stroke-opacity="0.45"
                    stroke-width="0.7"
                  />
                )}
                <circle cx={h.anchor[0]} cy={h.anchor[1]} r="1.8" fill="#0a1f44" />
              </g>
            ))}
          </g>

          <!-- Airport -->
          <g transform={`translate(${ax} ${ay})`} class="airport">
            <circle r="6.5" fill="#0a1f44"></circle>
            <path
              d="M3.2 0 L1 -.4 L.2 -2.2 L-.4 -2.2 L.1 -.4 L-1.5 -.35 L-2.1 -1.1 L-2.5 -1.1 L-2.15 0 L-2.5 1.1 L-2.1 1.1 L-1.5 .35 L.1 .4 L-.4 2.2 L.2 2.2 L1 .4 Z"
              fill="#e9c274"
              transform="rotate(-35) scale(1.25)"
            ></path>
            <text x="-10" y="3" text-anchor="end" font-size="8" font-weight="700" fill="#0a1f44" letter-spacing="1">
              CMB
            </text>
          </g>

          <!-- Compass rose -->
          <g transform="translate(-4 388)" class="compass" fill="#e9c274">
            <circle r="17" fill="none" stroke="#e9c274" stroke-opacity="0.45" stroke-width="0.7"></circle>
            <circle r="12" fill="none" stroke="#e9c274" stroke-opacity="0.25" stroke-width="0.5"></circle>
            <path d="M0 -21 L3 0 L0 21 L-3 0 Z" fill-opacity="0.9"></path>
            <path d="M-21 0 L0 -3 L21 0 L0 3 Z" fill-opacity="0.45"></path>
            <text y="-25" text-anchor="middle" font-size="8" font-weight="700" fill="#e9c274">
              N
            </text>
          </g>
        </svg>

        <!-- Pins -->
        <ul class="absolute inset-0" aria-label={T.places}>
          {items.map((h, i) => (
            <li
              class="pin-wrap absolute"
              style={`left:${h.pos.left.toFixed(2)}%;top:${h.pos.top.toFixed(2)}%;--d:${(i % 7) * 70}ms`}
              data-cat={h.category}
            >
              <a
                href={`#hl-${h.id}`}
                class="pin"
                data-pin={h.id}
                data-cat={h.category}
                aria-label={`${h.copy.name} — ${CATEGORY_META[h.category][lang]}`}
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 sm:size-[1.15rem]"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={PLACE_ICONS[h.icon]} />
                </svg>
                <span class="pin-label" aria-hidden="true">
                  {h.copy.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-4 flex items-center justify-center gap-2 text-xs text-white/60">
        <span class="inline-block h-px w-6 border-t border-dashed border-white/60" aria-hidden="true"></span>
        {T.route}
      </p>
    </div>

    <!-- Copy + themes -->
    <div class="[grid-area:copy]">
      <p class="reveal chapter">
        <span class="chapter-no">{index}</span>
        <span class="chapter-rule" aria-hidden="true"></span>
        <span>{T.eyebrow}</span>
      </p>
      <h2 id="atlas-heading" class="reveal mt-4 text-h2" set:html={T.title} />
      <p class="reveal mt-5 max-w-[48ch] text-lg text-white/75">{T.intro}</p>

      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label={T.themes}>
        <button type="button" class="theme-chip" data-theme-btn="all" aria-pressed="true">
          <Icon name="globe" class="size-4" />
          {T.all}
        </button>
        {HIGHLIGHT_CATEGORIES.map((c) => (
          <button type="button" class="theme-chip" data-theme-btn={c} aria-pressed="false">
            <Icon name={CAT_ICON[c]} class="size-4" />
            {CATEGORY_META[c][lang]}
          </button>
        ))}
      </div>
    </div>

    <div class="[grid-area:list]">
      <ul class="place-list flex flex-wrap gap-2" aria-label={T.places}>
        {items.map((h) => (
          <li data-cat={h.category}>
            <a href={`#hl-${h.id}`} class="place-btn" data-pin={h.id}>
              {h.copy.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="[grid-area:card]">
      <div class="postcards" aria-live="polite">
        {items.map((h) => (
          <article id={`hl-${h.id}`} class="postcard" data-card={h.id} data-cat={h.category}>
            <div class="relative aspect-[16/10] overflow-hidden rounded-t-[1.25rem] bg-ocean-700">
              {h.img && <Media image={h.img.image} alt={h.img.alt} sizes="(min-width: 1024px) 40vw, 92vw" />}
              <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-pill bg-ocean-900/80 px-3 py-1 text-xs font-semibold text-gold-300 backdrop-blur">
                <svg
                  viewBox="0 0 24 24"
                  class="size-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={PLACE_ICONS[h.icon]} />
                </svg>
                {CATEGORY_META[h.category][lang]}
              </span>
            </div>
            <div class="rounded-b-[1.25rem] bg-white p-6 text-ink-900">
              <h3 class="font-display text-3xl leading-tight">{h.copy.name}</h3>
              <p class="mt-2 text-[#4d5b75]">{h.copy.text}</p>
              {h.href && (
                <a
                  href={h.href}
                  class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-ocean-700 underline-offset-4 hover:underline"
                >
                  {h.tourType ? T.tour : T.explore} <Icon name="arrow" class="size-4" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .atlas-grid {
    grid-template-areas: 'copy' 'map' 'list' 'card';
  }
  @media (width >= 64rem) {
    .atlas-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas: 'map copy' 'map list' 'map card';
    }
  }
  .sea-label {
    font-family: var(--font-display);
    font-style: italic;
  }

  /* Pins: navy discs with a gold ring; the active pin turns gold and shows its name. */
  .pin-wrap {
    transform: translate(-50%, -50%);
  }
  .pin {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--c-ocean-900);
    color: #fff;
    box-shadow:
      0 0 0 2px var(--c-gold-500),
      0 6px 14px -4px rgb(0 0 0 / 0.55);
    transition:
      transform 250ms var(--ease-travel),
      background-color 250ms var(--ease-travel),
      color 250ms var(--ease-travel);
  }
  @media (width >= 40rem) {
    .pin {
      width: 2rem;
      height: 2rem;
    }
  }
  .pin:hover,
  .pin:focus-visible {
    transform: scale(1.15);
    z-index: 2;
  }
  .pin-label {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    translate: -50% 0;
    white-space: nowrap;
    border-radius: 999px;
    background: #fff;
    color: var(--c-ocean-900);
    padding: 0.2rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms;
  }
  .pin:hover .pin-label,
  .pin:focus-visible .pin-label,
  .pin[aria-current='true'] .pin-label {
    opacity: 1;
  }
  /* Desktop: every name is visible under its icon (the layout reserves room for it). */
  @media (width >= 64rem) {
    .pin-label {
      bottom: auto;
      top: calc(100% + 0.2rem);
      padding: 0.05rem 0.45rem;
      font-size: 0.68rem;
      opacity: 1;
      background: rgb(255 255 255 / 0.92);
    }
  }
  /* A theme dims the other pins instead of hiding them, so the whole island stays readable. */
  .pin-wrap.is-dim,
  .leader.is-dim {
    opacity: 0.18;
  }
  .pin-wrap {
    transition: opacity 300ms var(--ease-travel);
  }
  .pin[aria-current='true'] {
    background: var(--c-gold-500);
    color: var(--c-ocean-900);
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 8px rgb(217 169 74 / 0.3),
      0 8px 18px -4px rgb(0 0 0 / 0.6);
    z-index: 3;
  }
  .pin-wrap:has([aria-current='true']) {
    z-index: 3;
  }

  /* Theme chips + place buttons. */
  .theme-chip {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    transition:
      background-color 200ms,
      border-color 200ms,
      color 200ms;
  }
  .theme-chip:hover {
    border-color: var(--c-gold-400);
  }
  .theme-chip[aria-pressed='true'] {
    background: var(--c-gold-500);
    border-color: var(--c-gold-500);
    color: var(--c-ocean-900);
  }
  .place-btn {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    padding: 0 0.9rem;
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.85);
  }
  .place-btn:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .place-btn[aria-current='true'] {
    background: #fff;
    color: var(--c-ocean-900);
    font-weight: 700;
  }

  .postcard {
    border-radius: 1.25rem;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  /* No JS: every postcard is listed. With JS: one theme, one postcard at a time. */
  :global(.js) .postcard {
    display: none;
  }
  :global(.js) .postcard.is-active {
    display: block;
    animation: card-in 450ms var(--ease-travel);
  }
  :global(.js) .postcards {
    min-height: 26rem;
  }
  .postcards {
    display: grid;
    gap: 1.5rem;
  }
  .place-list li.is-hidden {
    display: none;
  }

  /* Entrance: coastline draws itself, the route follows, pins drop in. */
  :global(.js) .atlas .coast {
    stroke-dasharray: 3200;
    stroke-dashoffset: 3200;
  }
  :global(.js) .atlas .route {
    opacity: 0;
  }
  :global(.js) .atlas.is-in .coast {
    animation: draw 2.4s var(--ease-travel) forwards;
  }
  :global(.js) .atlas.is-in .route {
    animation: fade 900ms 1.4s forwards;
  }
  :global(.js) .atlas .pin-wrap {
    opacity: 0;
  }
  :global(.js) .atlas.is-in .pin-wrap {
    animation: pin-in 600ms var(--ease-travel) both;
    animation-delay: calc(900ms + var(--d));
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @keyframes pin-in {
    from {
      opacity: 0;
      transform: translate(-50%, -90%);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .atlas .coast {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
    :global(.js) .atlas .route,
    :global(.js) .atlas .pin-wrap {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-atlas]');
  if (root) {
    const pins = [...root.querySelectorAll<HTMLAnchorElement>('[data-pin]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const themes = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-btn]')];
    const wraps = [...root.querySelectorAll<HTMLElement>('.pin-wrap, .leader')];
    const listItems = [...root.querySelectorAll<HTMLElement>('.place-list li')];

    const show = (id: string) => {
      pins.forEach((p) => p.setAttribute('aria-current', String(p.dataset.pin === id)));
      cards.forEach((c) => c.classList.toggle('is-active', c.dataset.card === id));
    };
    const theme = (cat: string) => {
      themes.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.themeBtn === cat)));
      wraps.forEach((el) => el.classList.toggle('is-dim', cat !== 'all' && el.dataset.cat !== cat));
      listItems.forEach((el) => el.classList.toggle('is-hidden', cat !== 'all' && el.dataset.cat !== cat));
      const firstCard = cat === 'all' ? null : cards.find((c) => c.dataset.cat === cat);
      if (firstCard) show(firstCard.dataset.card!);
    };

    pins.forEach((p) =>
      p.addEventListener('click', (e) => {
        e.preventDefault(); // stay on the map; the postcard opens alongside
        show(p.dataset.pin!);
        // On phones the postcard sits below the map — bring it into view.
        if (window.matchMedia('(max-width: 1023px)').matches) {
          root.querySelector('.postcards')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }),
    );
    themes.forEach((t) => t.addEventListener('click', () => theme(t.dataset.themeBtn!)));
    show(root.dataset.default!);

    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          root.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    ).observe(root);
  }
</script>
