---
import Icon from '../ui/Icon.astro';
import Media from '../ui/Media.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { IconName } from '../../lib/icons';
import { getEntries, byOrder } from '../../lib/content';
import { photo, type PhotoName } from '../../lib/photos';

// "All-in-one" bento (docs/04 §5.4): 12 services as numbered tiles; the two feature tiles carry a photo.
const services = (await getEntries('services')).sort(byOrder);
const FEATURE: Record<string, { span: string; photo: PhotoName }> = {
  'flight-tickets': { span: 'col-span-2 md:row-span-2', photo: 'airport' },
  'ayurveda-packages': { span: 'col-span-2', photo: 'misty-hills' },
};
---

<section class="container-site py-24" aria-labelledby="bento-heading">
  <SectionHeading
    index="01"
    eyebrow="Everything in one place"
    title="One team for your *whole journey.*"
    id="bento-heading"
  />
  <ul class="mt-12 grid grid-flow-dense auto-rows-[minmax(160px,auto)] grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
    {services.map((s, i) => {
      const feature = FEATURE[s.id];
      const bg = feature && photo(feature.photo);
      return (
        <li class:list={['reveal', feature?.span]}>
          <a
            href={`/services/${s.id}`}
            class:list={[
              'lift group relative isolate flex h-full flex-col justify-between gap-6 overflow-hidden rounded-card p-5 ring-1 ring-line shadow-card sm:p-6',
              feature ? 'bg-ocean-900 text-white' : 'bg-surface',
            ]}
          >
            {bg && (
              <>
                <Media
                  image={bg.image}
                  alt=""
                  class="absolute inset-0 -z-20 transition-transform duration-700 ease-travel group-hover:scale-105"
                  sizes="(min-width: 768px) 50vw, 100vw"
                />
                <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(7_26_51/0.25),rgb(7_26_51/0.9))]" />
              </>
            )}
            <span class="flex items-start justify-between">
              <Icon
                name={s.data.icon as IconName}
                class:list={[
                  'size-9 transition-transform duration-300 ease-travel group-hover:-rotate-6 group-hover:scale-110',
                  feature ? 'text-lagoon-300' : 'text-ocean-500 dark:text-lagoon-300',
                ]}
              />
              <span class:list={['font-display text-sm italic', feature ? 'text-white/70' : 'text-muted']}>
                {String(i + 1).padStart(2, '0')}
              </span>
            </span>
            <span>
              <span class:list={['block font-display font-semibold', feature ? 'text-3xl sm:text-4xl' : 'text-lg']}>
                {s.data.title}
              </span>
              <span class:list={['mt-1 block text-sm', feature ? 'text-white/85' : 'text-muted']}>{s.data.short}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
