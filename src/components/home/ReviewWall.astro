---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { getEntries } from '../../lib/content';
import { SITE } from '../../lib/site';

// Real reviews only, with permission, source and date (docs/05 §7). Until they exist, link to the real profiles.
interface Props {
  limit?: number;
  index?: string;
}
const { limit = 9, index } = Astro.props;
const reviews = (await getEntries('testimonials'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
const sourceName = { google: 'Google', tripadvisor: 'Tripadvisor', facebook: 'Facebook', email: 'Email' } as const;
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
---

<section class="container-site py-24" aria-labelledby="reviews-heading">
  <SectionHeading index={index} eyebrow="Reviews" title="In our travellers’ *own words.*" id="reviews-heading" />
  {reviews.length ? (
    <div class="mt-12 columns-1 gap-6 sm:columns-2 lg:columns-3">
      {reviews.map((r) => (
        <figure class="reveal mb-6 break-inside-avoid rounded-card bg-surface p-6 ring-1 ring-line shadow-card">
          {r.data.rating && (
            <p class="text-gold-500" aria-label={`Rated ${r.data.rating} out of 5`}>
              {'★'.repeat(r.data.rating)}
            </p>
          )}
          <blockquote class="mt-3">{r.data.text}</blockquote>
          <figcaption class="mt-4 text-sm text-muted">
            <span class="font-semibold text-text">{r.data.name}</span>
            {r.data.country && `, ${r.data.country}`} ·{' '}
            {r.data.url ? (
              <a href={r.data.url} rel="noopener" class="underline">
                {sourceName[r.data.source]}
              </a>
            ) : (
              sourceName[r.data.source]
            )}{' '}
            · {fmt.format(r.data.date)}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div class="reveal mt-10 max-w-2xl rounded-card border border-dashed border-line p-8">
      <p class="text-muted">
        We are gathering reviews from recent travellers to show here. In the meantime, read what people say about us on
        Facebook — or ask us to put you in touch with past clients.
      </p>
      <Button href={SITE.facebook} variant="secondary" class="mt-6" rel="noopener">
        Paradise Travels on Facebook
      </Button>
    </div>
  )}
</section>
