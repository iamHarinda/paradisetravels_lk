---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getEntries } from '../../lib/content';
import { SITE, whatsappLink } from '../../lib/site';

// Real reviews only, with permission, source and date (docs/05 §7). Until they exist, link to the real profiles.
interface Props {
  limit?: number;
  index?: string;
  /** Off on /reviews, where the page hero already says it. */
  heading?: boolean;
}
const { limit = 9, index, heading = true } = Astro.props;
const reviews = (await getEntries('testimonials'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit);
const sourceName = { google: 'Google', tripadvisor: 'Tripadvisor', facebook: 'Facebook', email: 'Email' } as const;
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
---

<section
  class:list={['container-site', heading ? 'py-24' : 'pb-24']}
  aria-labelledby={heading ? 'reviews-heading' : undefined}
  aria-label={heading ? undefined : 'Reviews'}
>
  {heading && (
    <SectionHeading index={index} eyebrow="Reviews" title="In our travellers’ *own words.*" id="reviews-heading" />
  )}
  {reviews.length ? (
    <div class:list={['columns-1 gap-6 sm:columns-2 lg:columns-3', heading && 'mt-12']}>
      {reviews.map((r) => (
        <figure class="reveal mb-6 break-inside-avoid rounded-card bg-surface p-6 ring-1 ring-line shadow-card">
          {r.data.rating && (
            <p class="text-gold-500" aria-label={`Rated ${r.data.rating} out of 5`}>
              {'★'.repeat(r.data.rating)}
            </p>
          )}
          <blockquote class="mt-3">{r.data.text}</blockquote>
          <figcaption class="mt-4 text-sm text-muted">
            <span class="font-semibold text-text">{r.data.name}</span>
            {r.data.country && `, ${r.data.country}`} ·{' '}
            {r.data.url ? (
              <a href={r.data.url} rel="noopener" class="underline">
                {sourceName[r.data.source]}
              </a>
            ) : (
              sourceName[r.data.source]
            )}{' '}
            · {fmt.format(r.data.date)}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <div
      class:list={[
        'reveal relative grid gap-8 overflow-hidden rounded-media bg-surface p-8 ring-1 ring-line shadow-card sm:p-12 md:grid-cols-[auto_1fr] md:items-center md:gap-12',
        heading && 'mt-12',
      ]}
    >
      <span
        class="hidden font-display text-[10rem] leading-[0.6] text-ocean-500/20 select-none md:block dark:text-lagoon-300/25"
        aria-hidden="true"
      >
        &ldquo;
      </span>
      <div>
        <p class="font-display text-[clamp(1.5rem,1.5vw+1rem,2.25rem)] leading-tight">
          Ask the people who have travelled with us.
        </p>
        <p class="mt-4 max-w-[60ch] text-muted">
          We are gathering reviews from recent travellers to show here. In the meantime, read what people say about us
          on Facebook — or ask us to put you in touch with past clients.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={SITE.facebook} variant="secondary" rel="noopener">
            Paradise Travels on Facebook <Icon name="external" class="size-4" />
          </Button>
          <Button
            href={whatsappLink('Hello Paradise Travels, could you put me in touch with a past client for a reference?')}
            variant="ghost"
            rel="noopener"
            data-track="whatsapp"
          >
            <Icon name="whatsapp" class="size-4" /> Ask for a reference
          </Button>
        </div>
      </div>
    </div>
  )}
</section>
