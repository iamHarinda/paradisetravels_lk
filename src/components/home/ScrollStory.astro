---
import Media from '../ui/Media.astro';
import { photo } from '../../lib/photos';

// "A journey across the island" (docs/04 §6 pinned storytelling).
// Default (no JS, mobile, reduced motion): each chapter shows its own image, side by side with the text.
// Enhanced (desktop + motion allowed): GSAP ScrollTrigger pins one media frame and crossfades it as the text scrolls.
type Chapter = {
  title: string;
  text: string;
  tone: 'ocean' | 'tea' | 'heritage' | 'wild';
  photo: ReturnType<typeof photo>;
  href: string;
};
const chapters: Chapter[] = [
  {
    title: 'The coast',
    text: 'Fort walls in Galle, whales off Mirissa, surf at Arugam Bay — and a beach in season all year.',
    tone: 'ocean',
    photo: photo('mirissa'),
    href: '/experiences/beaches',
  },
  {
    title: 'The tea hills',
    text: 'Misty estates, planters’ bungalows and the slow, beautiful train from Kandy to Ella.',
    tone: 'tea',
    photo: photo('tea-hills'),
    href: '/experiences/tea-country',
  },
  {
    title: 'The ancient cities',
    text: 'Sigiriya at sunrise, painted caves and two-thousand-year-old stupas.',
    tone: 'heritage',
    photo: photo('sigiriya'),
    href: '/experiences/culture-heritage',
  },
  {
    title: 'The wild',
    text: 'Leopards in Yala and herds of elephants in Udawalawe.',
    tone: 'wild',
    photo: photo('yala'),
    href: '/experiences/wildlife-safaris',
  },
];
---

<section class="story container-site py-24" aria-labelledby="story-heading" data-story>
  <p class="reveal eyebrow">A journey across the island</p>
  <h2 id="story-heading" class="reveal mt-3 max-w-[16ch] text-h2">
    Four landscapes, one trip.
  </h2>
  <div class="story-grid mt-12">
    <div class="story-pin" aria-hidden="true">
      <div class="sticky top-28 aspect-[4/5] overflow-hidden rounded-media" data-story-media>
        {chapters.map((c, i) => (
          <div class:list={['absolute inset-0', i > 0 && 'opacity-0']} data-story-layer>
            <Media image={c.photo.image} alt="" tone={c.tone} sizes="50vw" />
          </div>
        ))}
      </div>
    </div>
    <ol class="story-steps grid gap-10">
      {chapters.map((c, i) => (
        <li class="story-step" data-story-step>
          <div class="reveal grid items-center gap-6 md:grid-cols-2 md:gap-12">
            <div
              class:list={['story-inline aspect-[4/3] overflow-hidden rounded-media', i % 2 === 1 && 'md:order-last']}
            >
              <Media image={c.photo.image} alt={c.photo.alt} tone={c.tone} sizes="(min-width: 768px) 50vw, 100vw" />
            </div>
            <div>
              <h3 class="text-4xl font-semibold">{c.title}</h3>
              <p class="mt-3 max-w-[40ch] text-lg text-muted">{c.text}</p>
              <a href={c.href} class="mt-4 inline-block font-semibold text-primary underline underline-offset-4">
                Explore {c.title.replace('The ', '')}
              </a>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .story-pin {
    display: none;
  }
  /* Enhanced pinned layout — only once the GSAP script has taken over. */
  .story.is-enhanced .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .story.is-enhanced .story-pin {
    display: block;
  }
  .story.is-enhanced .story-inline {
    display: none;
  }
  .story.is-enhanced .story-steps {
    gap: 0;
  }
  .story.is-enhanced .story-step {
    display: flex;
    min-height: 80vh;
    align-items: center;
  }
  .story.is-enhanced .story-step > div {
    grid-template-columns: 1fr;
  }
</style>

<script>
  import { loadGsap, prefersReducedMotion, whenNear } from '../../scripts/gsap';

  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story && !prefersReducedMotion() && window.matchMedia('(min-width: 1024px)').matches) {
    whenNear(story, async () => {
      const { gsap, ScrollTrigger } = await loadGsap();
      story.classList.add('is-enhanced');
      const layers = story.querySelectorAll<HTMLElement>('[data-story-layer]');
      story.querySelectorAll('[data-story-step]').forEach((step, i) => {
        ScrollTrigger.create({
          trigger: step,
          start: 'top center',
          end: 'bottom center',
          onToggle: (self) => {
            if (!self.isActive) return;
            layers.forEach((layer, j) =>
              gsap.to(layer, { opacity: j === i ? 1 : 0, duration: 0.7, ease: 'power2.out' }),
            );
          },
        });
      });
      // Subtle parallax on the pinned media (≤ 10%, docs/04 §6).
      gsap.fromTo(
        story.querySelector('[data-story-media]'),
        { yPercent: 4 },
        { yPercent: -4, ease: 'none', scrollTrigger: { trigger: story, scrub: true } },
      );
      ScrollTrigger.refresh();
    });
  }
</script>
