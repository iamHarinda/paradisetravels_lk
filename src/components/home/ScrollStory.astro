---
import Media from '../ui/Media.astro';
import { photo } from '../../lib/photos';

// "A journey across the island" — vertical stacking cards. As you scroll down (the way people scroll Reels/TikTok),
// each landscape slides up over the previous one and the earlier cards stack at the top with their edges showing.
// Pure CSS position: sticky — no JS, identical on phone and desktop, works with reduced motion.
type Chapter = {
  title: string;
  text: string;
  photo: ReturnType<typeof photo>;
  href: string;
};
const chapters: Chapter[] = [
  {
    title: 'The coast',
    text: 'Fort walls in Galle, whales off Mirissa, surf at Arugam Bay — and a beach in season all year.',
    photo: photo('mirissa'),
    href: '/experiences/beaches',
  },
  {
    title: 'The tea hills',
    text: 'Misty estates, planters’ bungalows and the slow, beautiful train from Kandy to Ella.',
    photo: photo('ella-train'),
    href: '/experiences/tea-country',
  },
  {
    title: 'The ancient cities',
    text: 'Sigiriya at sunrise, painted caves and two-thousand-year-old stupas.',
    photo: photo('polonnaruwa'),
    href: '/experiences/culture-heritage',
  },
  {
    title: 'The wild',
    text: 'Leopards in Yala and herds of elephants in Udawalawe.',
    photo: photo('yala'),
    href: '/experiences/wildlife-safaris',
  },
];
---

<section class="journey relative py-24" aria-labelledby="story-heading">
  <div class="container-site">
    <p class="reveal chapter">
      <span class="chapter-no">05</span>
      <span class="chapter-rule" aria-hidden="true"></span>
      <span>A journey across the island</span>
    </p>
    <h2 id="story-heading" class="reveal mt-4 max-w-[16ch] text-h2">
      Four landscapes, <em class="accent">one trip.</em>
    </h2>

    <ol class="mt-12">
      {chapters.map((c, i) => (
        <li class="stack-card" style={`--i:${i}`}>
          <article class="group relative h-full overflow-hidden rounded-media text-white shadow-[var(--shadow-lift)] ring-1 ring-black/5">
            <Media
              image={c.photo.image}
              alt={c.photo.alt}
              class="absolute inset-0 transition-transform duration-[1.2s] ease-travel group-hover:scale-105"
              sizes="(min-width: 1440px) 1360px, 100vw"
            />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(7_26_51/0.05)_35%,rgb(7_26_51/0.82))]" />
            <span
              class="pointer-events-none absolute top-4 right-6 font-display text-[clamp(4.5rem,11vw,10rem)] leading-none text-transparent italic [-webkit-text-stroke:1.5px_rgb(255_255_255/0.6)]"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10 lg:p-14">
              <h3 class="text-[clamp(2.25rem,3.5vw+1rem,4.5rem)] leading-none font-medium">{c.title}</h3>
              <p class="mt-4 max-w-[46ch] text-white/90 sm:text-lg">{c.text}</p>
              <a
                href={c.href}
                class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-pill bg-white px-5 text-sm font-semibold text-ocean-900 hover:bg-sky-100"
              >
                Explore {c.title.replace('The ', '')} →
              </a>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Stacking cards: each card sticks a little lower than the previous one, so the stack shows its edges. */
  .stack-card {
    position: sticky;
    top: calc(6rem + var(--i) * 1.25rem);
    height: min(72svh, 46rem);
    margin-bottom: 14svh;
  }
  .stack-card:last-child {
    margin-bottom: 0;
  }
  @media (width < 40rem) {
    .stack-card {
      top: calc(5.5rem + var(--i) * 0.75rem);
      height: min(70svh, 36rem);
      margin-bottom: 10svh;
    }
  }
</style>
