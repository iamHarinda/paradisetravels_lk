---
import { REGIONS, type RegionId } from '../../lib/seasons';
import MapLand from '../ui/MapLand.astro';
import { MAP_VIEWBOX, project } from '../../lib/geo';

interface Props {
  places: { id: string; title: string; region: RegionId; coords: [number, number] }[];
  class?: string;
}
const { places, class: className } = Astro.props;

// Label placement for places whose dots sit close together; default: right of the dot (left near the east coast).
type Side = 'left' | 'right' | 'above' | 'below';
const LABEL: Record<string, Side> = {
  sigiriya: 'above',
  dambulla: 'left',
  polonnaruwa: 'right',
  'arugam-bay': 'left',
  ella: 'below',
  yala: 'below',
  mirissa: 'below',
};
const labelPos = (id: string, x: number, y: number) => {
  const side: Side = LABEL[id] ?? (x < 190 ? 'right' : 'left');
  if (side === 'above') return { x, y: y - 9, anchor: 'middle' };
  if (side === 'below') return { x, y: y + 16, anchor: 'middle' };
  return side === 'right' ? { x: x + 8, y: y + 3.5, anchor: 'start' } : { x: x - 8, y: y + 3.5, anchor: 'end' };
};
---

<svg viewBox={MAP_VIEWBOX} class={className} role="img" aria-labelledby="map-title">
  <title id="map-title">Map of Sri Lanka showing our destinations</title>
  <MapLand id="island" />
  {places.map((p) => {
    const [x, y] = project(p.coords);
    const label = labelPos(p.id, x, y);
    return (
      <a
        href={`/destinations/${p.id}`}
        class="map-place"
        data-region={p.region}
        aria-label={`${p.title} — ${REGIONS[p.region].name}`}
      >
        <circle cx={x} cy={y} r="4.5" />
        <circle cx={x} cy={y} r="11" fill="transparent" />
        <text x={label.x} y={label.y} font-size="10" text-anchor={label.anchor} fill="currentColor">
          {p.title.replace(' National Park', '')}
        </text>
      </a>
    );
  })}
</svg>

<style>
  .map-place {
    color: #51607a;
    transition: color 200ms;
  }
  .map-place circle:first-child {
    fill: currentColor;
  }
  .map-place:hover,
  .map-place:focus-visible {
    color: var(--c-ocean-500);
    font-weight: 600;
  }
  /* Selected region / in-season places: warm yellow so they pop against the blue map.
     Label text uses dark amber (≈ 7:1 on white) so it stays readable. */
  .map-place.is-active {
    color: #92400e;
    font-weight: 700;
  }
  .map-place.is-active circle:first-child {
    fill: #facc15;
    stroke: #b45309;
    stroke-width: 1.2;
    transform: scale(1.35);
    transform-box: fill-box;
    transform-origin: center;
  }
  .map-place.is-active circle:nth-child(2) {
    fill: rgb(250 204 21 / 0.28);
  }
  .map-place circle {
    transition:
      transform 250ms var(--ease-travel),
      fill 250ms var(--ease-travel);
  }
</style>
