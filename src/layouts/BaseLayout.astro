---
import { Font } from 'astro:assets';
import SEO, { type Props as SEOProps } from '../components/layout/SEO.astro';
import '../styles/global.css';

export type Props = SEOProps;

const props = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071a33" />
    <!-- Mark JS before first paint so enhanced layouts render in their final shape (no CLS). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Preload only the display font used above the fold (docs/04 §3). -->
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-inter" />
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
