---
import { Font } from 'astro:assets';
import SEO, { type Props as SEOProps } from '../components/layout/SEO.astro';
import '../styles/global.css';
import { langFromPath } from '../lib/i18n';
import Analytics from '../components/analytics/Analytics.astro';
import ConsentBanner from '../components/analytics/ConsentBanner.astro';

export type Props = SEOProps;

const props = Astro.props;
const lang = langFromPath(Astro.url.pathname);
// <!--email_off--> … <!--/email_off--> around the body opts every page out of Cloudflare Email Address Obfuscation,
// which rewrites mailto links to /cdn-cgi/l/email-protection — crawlers report that as a broken link on every page.
---

<!doctype html>
<html lang={lang === 'ko' ? 'ko' : 'en-GB'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1f44" />
    <!-- Mark JS before first paint so enhanced layouts render in their final shape (no CLS). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Preload only the display font used above the fold (docs/04 §3). -->
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-inter" />
    <SEO {...props} />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <Fragment set:html="<!--email_off-->" />
    <a class="skip-link" href="#main">
      {lang === 'ko' ? '본문 바로가기' : 'Skip to content'}
    </a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <ConsentBanner />
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
