---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyBar from '../components/layout/StickyBar.astro';
import FloatingContact from '../components/layout/FloatingContact.astro';
import Breadcrumbs, { type Crumb } from '../components/layout/Breadcrumbs.astro';
import FlightBackdrop from '../components/layout/FlightBackdrop.astro';
import type { Props as SEOProps } from '../components/layout/SEO.astro';
import { SITE } from '../lib/site';
import { langFromPath } from '../lib/i18n';

type Props = SEOProps & {
  /** Trail after "Home". Renders breadcrumbs + BreadcrumbList schema on all non-home pages. */
  breadcrumbs?: Crumb[];
  overlayHeader?: boolean;
  /** Replaces "Plan trip" in the mobile contact bar, e.g. "Enquire" on a tour page. */
  primaryAction?: { href: string; label: string };
};

const { breadcrumbs, overlayHeader = false, primaryAction, jsonLd = [], ...seo } = Astro.props;
const ko = langFromPath(Astro.url.pathname) === 'ko';
const trail = breadcrumbs ? [{ name: ko ? '홈' : 'Home', href: ko ? '/ko' : '/' }, ...breadcrumbs] : undefined;
const breadcrumbSchema = trail && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, SITE.url).toString(),
  })),
};
---

<BaseLayout {...seo} jsonLd={breadcrumbSchema ? [...jsonLd, breadcrumbSchema] : jsonLd}>
  <slot name="head" slot="head" />
  <Fragment slot="header">
    <FlightBackdrop />
    <Header overlay={overlayHeader} />
  </Fragment>
  {trail && <Breadcrumbs items={trail} class="container-site pt-6" />}
  <slot />
  <Fragment slot="footer">
    <Footer />
    <StickyBar primaryAction={primaryAction} />
    <FloatingContact />
  </Fragment>
</BaseLayout>

<script>
  import '../scripts/site.ts';
</script>
