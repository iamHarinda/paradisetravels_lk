---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBlock from '../components/ui/CtaBlock.astro';
import Icon from '../components/ui/Icon.astro';
import { getEntries, byOrder } from '../lib/content';
import { SITE } from '../lib/site';
import { photo } from '../lib/photos';

const hero = photo('colombo-fort');

const team = (await getEntries('team')).sort(byOrder);
const values = [
  {
    title: 'Honest advice',
    text: 'We tell you about the monsoon, the traffic and the crowds — not just the highlights.',
  },
  { title: 'One team', text: 'From the flight to the farewell, the same people look after you.' },
  { title: 'Local roots', text: `Based in Nugegoda, Colombo, since ${SITE.foundingYear}.` },
];
---

<PageLayout
  title={`About Paradise Travels | Colombo Since ${SITE.foundingYear}`}
  description={`Paradise Travels (Pvt) Ltd is a family-run travel agency in Nugegoda, Colombo, arranging flights, tours, hotels and events in Sri Lanka since ${SITE.foundingYear}.`}
  breadcrumbs={[{ name: 'About', href: '/about' }]}
>
  <PageHero
    eyebrow="About us"
    title={`Arranging travel from Colombo *since ${SITE.foundingYear}.*`}
    intro="Paradise Travels started as an air-ticketing agency and grew into an all-in-one travel partner: tours, partner hotels, drivers, guides, interpreters, events and Ayurveda — still run personally from our office in Nugegoda."
    tone="heritage"
    image={hero.image}
    imageAlt={hero.alt}
  />

  <section class="container-site grid gap-12 pb-16 lg:grid-cols-[2fr_1fr]">
    <div class="prose">
      <h2>Our story</h2>
      <p>
        {SITE.legalName} was established in {SITE.foundingYear}. For many years our work focused on international air
        tickets and consolidator fares from Sri Lanka to Asia, the Middle East, Europe, Africa, the Americas and the
        South Pacific — for families, groups and workers travelling overseas.
      </p>
      <p>
        Over time our clients asked us for more: hotels, transport, guides, visas, events. Today we look after
        travellers coming to Sri Lanka as well as Sri Lankans travelling abroad — with the same team handling every part
        of the journey.
      </p>
      <p>
        {
          '{{TODO: owner to add milestones, the Korea connection and the 2020 repatriation flight story (Daily News, 26 May 2020) once the article and details are confirmed.}}'
        }
      </p>
    </div>
    <aside class="space-y-4">
      {values.map((v) => (
        <div class="rounded-card bg-surface p-5 ring-1 ring-line shadow-card">
          <h3 class="flex items-center gap-2 text-lg font-semibold">
            <Icon name="check" class="size-4 text-ocean-500 dark:text-lagoon-300" /> {v.title}
          </h3>
          <p class="mt-1 text-sm text-muted">{v.text}</p>
        </div>
      ))}
    </aside>
  </section>

  {team.length > 0 && (
    <section class="container-site pb-24" aria-labelledby="team-heading">
      <h2 id="team-heading" class="text-h2">
        Leadership
      </h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((m) => (
          <li class="rounded-media bg-surface p-6 ring-1 ring-line shadow-card">
            <div
              class="grid size-20 place-items-center rounded-full bg-ocean-900 font-display text-2xl text-lagoon-300"
              aria-hidden="true"
            >
              {m.data.name
                .split(' ')
                .map((n) => n[0])
                .join('')}
            </div>
            <h3 class="mt-4 text-2xl font-semibold">{m.data.name}</h3>
            <p class="text-sm text-muted">{m.data.role}</p>
            {m.data.bio && <p class="mt-3 text-sm">{m.data.bio}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <CtaBlock />
</PageLayout>
