---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBlock from '../components/ui/CtaBlock.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../lib/site';
import { photo } from '../lib/photos';
import LeaderCard from '../components/ui/LeaderCard.astro';
import { getEntries } from '../lib/content';

const hero = photo('colombo-fort');

const values = [
  {
    title: 'Honest advice',
    text: 'We tell you about the monsoon, the traffic and the crowds — not just the highlights.',
  },
  { title: 'One team', text: 'From the flight to the farewell, the same people look after you.' },
  { title: 'Local roots', text: `Based in Nugegoda, Colombo, since ${SITE.foundingYear}.` },
  { title: 'Korean spoken', text: 'Our Chairman speaks Korean fluently — 30+ years of experience with Korea.' },
];
const leader = (await getEntries('team')).find((t) => t.data.order === 1);
---

<PageLayout
  title={`About Paradise Travels | Colombo Since ${SITE.foundingYear}`}
  description={`Paradise Travels (Pvt) Ltd is a family-run travel agency in Nugegoda, Colombo, arranging Sri Lanka tours, visas and air tickets since ${SITE.foundingYear}.`}
  breadcrumbs={[{ name: 'About', href: '/about' }]}
>
  <PageHero
    eyebrow="About us"
    title={`Arranging travel from Colombo *since ${SITE.foundingYear}.*`}
    intro="Paradise Travels started as an air-ticketing agency and grew into a full travel partner: tailor-made Sri Lanka tours, visa consultation and air tickets — still run personally from our office in Nugegoda."
    tone="heritage"
    image={hero.image}
    imageAlt={hero.alt}
  />

  <section class="container-site grid gap-12 pb-16 lg:grid-cols-[2fr_1fr]">
    <div class="prose">
      <h2>Our story</h2>
      <p>
        {SITE.legalName} was established in {SITE.foundingYear}. For many years our work focused on international air
        tickets and consolidator fares from Sri Lanka to Asia, the Middle East, Europe, Africa, the Americas and the
        South Pacific — for families, groups and workers travelling overseas.
      </p>
      <p>
        Over time our clients asked us for more: hotels, transport, guides, visas, events. Today we look after
        travellers coming to Sri Lanka as well as Sri Lankans travelling abroad — with the same team handling every part
        of the journey.
      </p>
      <h3>The Korea connection</h3>
      <p>
        Our Chairman and Managing Director, {leader?.data.name ?? 'our founder'}, has more than 30 years of experience
        with Korea and speaks Korean fluently. Korea is our leading market today, and Korean travellers can plan their
        trip with us in their own language — by KakaoTalk, WhatsApp, phone or email.
      </p>
    </div>
    <aside class="space-y-4">
      {values.map((v) => (
        <div class="rounded-card bg-surface p-5 ring-1 ring-line shadow-card">
          <h3 class="flex items-center gap-2 text-lg font-semibold">
            <Icon name="check" class="size-4 text-ocean-500 dark:text-lagoon-300" /> {v.title}
          </h3>
          <p class="mt-1 text-sm text-muted">{v.text}</p>
        </div>
      ))}
    </aside>
  </section>

  <section class="container-site pb-24" aria-labelledby="team-heading">
    <h2 id="team-heading" class="text-h2">
      Leadership
    </h2>
    <LeaderCard class="mt-8 max-w-3xl" />
  </section>

  <CtaBlock />
</PageLayout>
