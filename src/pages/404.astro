---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';

const popular = [
  ['Tours', '/tours'],
  ['Destinations', '/destinations'],
  ['Hotel Deals', '/hotel-deals'],
  ['Sri Lanka ETA 2026', '/travel-guide/sri-lanka-visa-eta'],
  ['Best time to visit', '/travel-guide/best-time-to-visit-sri-lanka'],
  ['Contact', '/contact'],
];
---

<PageLayout
  title="Page not found — Paradise Travels"
  description="This page could not be found. Go back to the Paradise Travels home page or contact our Colombo team on WhatsApp or email for help planning your trip."
  noindex
>
  <section class="container-site max-w-3xl py-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.05]">We couldn’t find that page.</h1>
    <p class="mt-5 text-lg text-muted">It may have moved while we rebuilt the site. Try one of these:</p>
    <ul class="mt-8 flex flex-wrap gap-2">
      {popular.map(([label, href]) => (
        <li>
          <a
            href={href}
            class="inline-flex min-h-12 items-center rounded-pill border border-line px-5 hover:border-primary"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <Button href="/" class="mt-10">
      Back to the home page
    </Button>
  </section>
</PageLayout>
