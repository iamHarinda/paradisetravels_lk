---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ServicesTrio from '../../components/home/ServicesTrio.astro';
import CtaBlock from '../../components/ui/CtaBlock.astro';
import { itemListSchema } from '../../lib/schema-org';
import { SITE } from '../../lib/site';
---

<PageLayout
  title="Sri Lanka Tours, Visa Consultation & Air Tickets"
  description={`Three services from one Colombo team since ${SITE.foundingYear}: tailor-made Sri Lanka tours, visa consultation and Sri Lanka ETA help, and air tickets on 12 airlines.`}
  breadcrumbs={[{ name: 'Services', href: '/services' }]}
  jsonLd={[
    itemListSchema([
      { name: 'Tours', path: '/tours' },
      { name: 'Visa Consultation', path: '/services/visa-consultation' },
      { name: 'Air Ticketing', path: '/services/air-ticketing' },
    ]),
  ]}
>
  <PageHero
    eyebrow="Services"
    title="Everything for your trip, *one team*"
    intro="Plan the tour, sort the visa, book the flights — with the same people from first message to flight home."
    media={false}
  />
  <ServicesTrio index="" />
  <CtaBlock title="Need more than one?" text="Most of our travellers combine all three. Tell us the whole plan." />
</PageLayout>
