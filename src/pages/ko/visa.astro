---
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import KoContactBand from '../../components/ko/KoContactBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { serviceSchema } from '../../lib/schema-org';
import { photo } from '../../lib/photos';

// Korean visa page. Travel facts carry "Last checked" + sources (CLAUDE.md hard rule 6); facts mirror
// src/content/guides/sri-lanka-visa-eta.md and docs/11 — re-verify both together.
const hero = photo('airport');
const lastChecked = '2026년 10월 22일';
const sources = [
  { title: '스리랑카 이민청 ETA 공지 (영문)', url: 'https://www.immigration.gov.lk/pages_e.php?id=60' },
  { title: '공식 ETA 신청 사이트 eta.gov.lk', url: 'https://eta.gov.lk' },
  {
    title: 'Newswire — 무료 관광 ETA 40개국 (영문)',
    url: 'https://www.newswire.lk/2026/05/25/sri-lanka-to-offer-free-tourist-eta-for-40-countries-from-may-25/',
  },
];
const steps = [
  { title: '필요한 비자 확인', body: '여권과 여행 목적에 맞는 ETA 또는 비자를 확인해 드립니다.' },
  { title: '서류 준비', body: '필요 서류 체크리스트를 드리고, 제출 전에 함께 검토합니다.' },
  {
    title: '공식 경로로 신청',
    body: '공식 포털 또는 대사관을 통해서만 신청합니다 — 비공식 대행 사이트는 사용하지 않습니다.',
  },
  { title: '승인까지 안내', body: '승인이 나올 때까지 진행 상황을 알려드립니다.' },
];
---

<PageLayout
  title="스리랑카 비자 · ETA 상담 | 파라다이스 트래블스"
  description="스리랑카 입국 전 필요한 ETA(전자여행허가) 안내와 비자 상담. 공식 사이트 eta.gov.lk 신청 방법과 주의사항."
  breadcrumbs={[{ name: '비자 상담', href: '/ko/visa' }]}
  jsonLd={[
    serviceSchema({
      title: '비자 상담',
      description: '스리랑카 ETA 안내와 비자 상담',
      path: '/ko/visa',
    }),
  ]}
>
  <PhotoHero
    eyebrow="비자 상담"
    title="스리랑카 ETA, *처음부터 정확하게.*"
    intro="스리랑카를 방문하는 모든 외국인은 입국 전에 ETA(전자여행허가)를 받아야 합니다. 무엇이 필요한지, 어디서 신청하는지 안내해 드립니다."
    image={hero.image}
    imageAlt={hero.alt}
  />

  <section class="container-site grid gap-12 py-20 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <h2 class="text-h2">알아두세요</h2>
      <ul class="mt-8 space-y-4">
        <li class="flex gap-3 rounded-card bg-surface p-5 shadow-card ring-1 ring-line">
          <Icon name="check" class="mt-1 size-5 shrink-0 text-gold-600" />
          <span>
            모든 외국인 방문객은 <strong>입국 전에 승인된 ETA</strong>가 필요합니다.
          </span>
        </li>
        <li class="flex gap-3 rounded-card bg-surface p-5 shadow-card ring-1 ring-line">
          <Icon name="check" class="mt-1 size-5 shrink-0 text-gold-600" />
          <span>
            2026년 5월 25일부터 <strong>대한민국</strong>을 포함한 <strong>40개국 국민</strong>은 관광 ETA를 무료로 받을 수
            있습니다 (첫 입국일부터 30일, 더블 엔트리). 무료 대상이어도 <strong>입국 전 ETA 신청은 필수</strong>입니다.
          </span>
        </li>
        <li class="flex gap-3 rounded-card bg-surface p-5 shadow-card ring-1 ring-line">
          <Icon name="check" class="mt-1 size-5 shrink-0 text-gold-600" />
          <span>
            신청은 반드시 공식 사이트{' '}
            <a href="https://eta.gov.lk" class="font-semibold underline" rel="noopener">
              eta.gov.lk
            </a>
            에서만 하세요. 수수료를 받는 비공식 사이트가 많습니다.
          </span>
        </li>
      </ul>

      <h2 class="mt-16 text-h2">진행 방법</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {steps.map((s, i) => (
          <li class="rounded-card bg-surface p-6 shadow-card ring-1 ring-line">
            <span class="grid size-9 place-items-center rounded-full bg-gold-500 text-sm font-bold text-ocean-900">
              {i + 1}
            </span>
            <h3 class="mt-4 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="mt-12 border-t border-line pt-6 text-sm text-muted">
        <p>최종 확인: {lastChecked}. 비자 규정은 수시로 바뀌므로 출발 전 반드시 공식 사이트를 확인하세요.</p>
        <ul class="mt-2 space-y-1">
          {sources.map((s) => (
            <li>
              출처:{' '}
              <a href={s.url} class="underline" rel="noopener">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <aside class="lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-media bg-surface p-6 shadow-card ring-1 ring-line sm:p-8">
        <h2 class="text-2xl font-semibold">비자 상담 문의</h2>
        <div class="mt-6">
          <EnquiryForm subject="Visa Consultation (KO)" />
        </div>
      </div>
    </aside>
  </section>

  <KoContactBand />
</PageLayout>
