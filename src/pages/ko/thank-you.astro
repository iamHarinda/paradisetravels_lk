---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { SITE, whatsappLink } from '../../lib/site';
---

<PageLayout
  title="감사합니다 — 파라다이스 트래블스"
  description="문의해 주셔서 감사합니다. 콜롬보의 파라다이스 트래블스 팀이 확인 후 답변 드리겠습니다. 급한 경우 카카오톡 또는 왓츠앱으로 연락 주세요."
  noindex
>
  <section class="container-site max-w-3xl py-24">
    <Icon name="check" class="size-14 rounded-full bg-gold-500 p-3 text-ocean-900" />
    <h1 class="mt-8 text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.1]">문의가 접수되었습니다.</h1>
    <p class="mt-5 text-lg text-muted">확인 메일을 보내드렸습니다. 콜롬보 팀이 확인 후 답변 드리겠습니다.</p>
    <p class="mt-3 text-muted">급한 경우 카카오톡 또는 왓츠앱 {SITE.phone}로 연락 주세요.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button
        href={whatsappLink('안녕하세요, 웹사이트로 문의를 보냈습니다.')}
        variant="whatsapp"
        rel="noopener"
        data-track="whatsapp"
      >
        <Icon name="whatsapp" /> 왓츠앱으로 연락하기
      </Button>
      <Button href="/ko/tours" variant="secondary">
        투어 둘러보기
      </Button>
    </div>
  </section>
</PageLayout>

<script>
  import { track } from '../../lib/analytics';
  track('generate_lead', { form: new URLSearchParams(location.search).get('type') ?? 'enquiry', language: 'ko' });
</script>
