---
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import AirlineLogos from '../../components/ui/AirlineLogos.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import KoContactBand from '../../components/ko/KoContactBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { AIRLINES } from '../../data/airlines';
import { serviceSchema } from '../../lib/schema-org';
import { photo } from '../../lib/photos';
import { SITE } from '../../lib/site';

const hero = photo('flight');
const offers = ['콜롬보 왕복 · 편도 항공권', '다구간 · 경유 일정', '단체 항공권', '날짜 변경 · 재발권 지원'];
---

<PageLayout
  title="스리랑카 항공권 · 대한항공 · 스리랑칸 항공 | 파라다이스 트래블스"
  description={`대한항공, 스리랑칸 항공, 싱가포르 항공, 캐세이퍼시픽 등 ${AIRLINES.length}개 항공사 항공권을 콜롬보 현지 여행사가 발권합니다. ${SITE.foundingYear}년부터 운영.`}
  breadcrumbs={[{ name: '항공권', href: '/ko/air-tickets' }]}
  jsonLd={[serviceSchema({ title: '항공권 발권', description: '스리랑카 항공권 발권', path: '/ko/air-tickets' })]}
>
  <PhotoHero
    eyebrow="항공권"
    title="서울에서 콜롬보까지, *항공권도 함께.*"
    intro={`${AIRLINES.length}개 항공사 항공권을 발권합니다. 일정이 바뀌어도 연락할 수 있는 사람이 있습니다.`}
    image={hero.image}
    imageAlt={hero.alt}
  />

  <section class="container-site py-20">
    <h2 class="text-h2">
      발권 <em class="accent">항공사</em>
    </h2>
    <AirlineLogos class="mt-8" />
    <p class="mt-3 text-xs text-muted">로고는 각 항공사의 상표입니다.</p>
  </section>

  <section class="container-site grid gap-12 pb-20 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <h2 class="text-h2">이런 항공권을 준비합니다</h2>
      <ul class="mt-8 space-y-3">
        {offers.map((o) => (
          <li class="flex items-center gap-3 rounded-card bg-surface p-5 shadow-card ring-1 ring-line">
            <Icon name="plane" class="size-5 shrink-0 text-gold-600" />
            <span class="font-medium">{o}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-media bg-surface p-6 shadow-card ring-1 ring-line sm:p-10">
      <h2 class="text-2xl font-semibold">항공권 문의</h2>
      <p class="mt-2 text-sm text-muted">출발지, 날짜, 인원을 알려주세요.</p>
      <div class="mt-6">
        <EnquiryForm subject="Air Ticketing (KO)" />
      </div>
    </div>
  </section>

  <KoContactBand />
</PageLayout>
