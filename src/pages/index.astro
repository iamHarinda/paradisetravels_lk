---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Bento from '../components/home/Bento.astro';
import CinematicReveal from '../components/home/CinematicReveal.astro';
import IslandExplorer from '../components/home/IslandExplorer.astro';
import ScrollStory from '../components/home/ScrollStory.astro';
import ReviewWall from '../components/home/ReviewWall.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Media from '../components/ui/Media.astro';
import CtaBlock from '../components/ui/CtaBlock.astro';
import TicketCard from '../components/tours/TicketCard.astro';
import AirlineLogos from '../components/ui/AirlineLogos.astro';
import { getEntries, byOrder } from '../lib/content';
import { travelAgencySchema } from '../lib/schema-org';
import { dateFmt } from '../lib/labels';
import { SITE } from '../lib/site';
import { photo } from '../lib/photos';
import { accent } from '../lib/text';

const tours = (await getEntries('tours')).sort(byOrder);
const featured = [
  ...tours.filter((t) => t.data.featured),
  ...tours.filter(
    (t) => !t.data.featured && (t.data.styles.includes('honeymoon') || t.data.styles.includes('ayurveda')),
  ),
].slice(0, 4);
const [hotels, guides, services, destinations] = await Promise.all([
  getEntries('hotels'),
  getEntries('guides'),
  getEntries('services'),
  getEntries('destinations'),
]);
const latestGuides = guides.sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 3);
const leader = (await getEntries('team')).find((t) => t.data.order === 1);
const dealsPhoto = photo('tangalle');

// Only verifiable numbers (CLAUDE.md hard rule 1).
const facts = [
  { value: String(SITE.foundingYear), label: 'Arranging travel from Colombo since' },
  { value: String(services.length), label: 'Services under one roof' },
  { value: String(destinations.length), label: 'Destinations we know first-hand' },
  { value: '1', label: 'Team for your whole journey' },
];
---

<PageLayout
  title="Sri Lanka Tours, Hotels & Travel Agency | Paradise Travels"
  description="Colombo travel agency since 2007: tailor-made Sri Lanka tours, partner hotel rates, flights, ETA and visa help, drivers, guides, events and Ayurveda."
  jsonLd={[travelAgencySchema()]}
>
  <Hero />
  <section class="container-site pb-14" aria-labelledby="airlines-heading">
    <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="airlines-heading" class="detail font-sans text-muted">
        Flight tickets on leading airlines
      </h2>
      <a href="/services/flight-tickets" class="text-sm font-semibold text-primary underline underline-offset-4">
        Book flights with us
      </a>
    </div>
    <AirlineLogos variant="strip" />
  </section>
  <Marquee />
  <Bento />
  <CinematicReveal line="Some places you have to see to believe." accentWord="see" />
  <IslandExplorer />

  <section class="container-site py-24" aria-labelledby="tours-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading index="03" eyebrow="Tours" title="Start with a route. *Make it yours.*" id="tours-heading" />
      <Button href="/tours" variant="secondary">
        All tours <Icon name="arrow" class="size-4" />
      </Button>
    </div>
    <div class="mt-12 grid gap-6 xl:grid-cols-2">
      {featured.map((t) => (
        <TicketCard tour={t} />
      ))}
    </div>
  </section>

  <section class="bg-sky-100 py-24 text-ink-900" aria-labelledby="deals-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <div class="relative aspect-[4/3] overflow-hidden rounded-media">
        <Media image={dealsPhoto.image} alt={dealsPhoto.alt} sizes="(min-width: 1024px) 45vw, calc(100vw - 2rem)" />
        <span class="detail absolute top-4 left-4 rounded-pill bg-gold-500 px-3 py-1.5 text-ocean-900">
          Paradise rate
        </span>
      </div>
      <div>
        <p class="reveal chapter text-ocean-700!">
          <span class="chapter-no">04</span>
          <span class="chapter-rule" aria-hidden="true"></span>
          <span>Hotel Deals</span>
        </p>
        <h2
          id="deals-heading"
          class="reveal mt-4 text-h2"
          set:html={accent('Partner rates you *won’t find* on booking sites.')}
        />
        <p class="reveal mt-5 text-lg text-[#3f4b63]">
          We hold contracted rates with hotels around the island. Tell us where and when — we reply with options and a
          quote. Book just the hotel, or the whole trip.
        </p>
        <Button href="/hotel-deals" class="mt-8">
          See hotel deals <Icon name="arrow" class="size-4" />
        </Button>
      </div>
    </div>
    {hotels.length > 0 && (
      <div class="container-site mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {hotels.slice(0, 4).map((h) => (
          <Card
            href={`/hotel-deals/${h.id}`}
            title={h.data.name}
            eyebrow={h.data.area}
            badge="Paradise rate"
            badgeTone="gold"
            image={h.data.heroImage}
            imageAlt={h.data.heroAlt}
            tone={h.data.tone}
            meta="Request this rate"
          />
        ))}
      </div>
    )}
  </section>

  <ScrollStory />

  <section class="bg-white py-24" aria-labelledby="why-heading">
    <div class="container-site">
      <p class="reveal chapter">
        <span class="chapter-no">06</span>
        <span class="chapter-rule" aria-hidden="true"></span>
        <span>Why Paradise Travels</span>
      </p>
      <h2
        id="why-heading"
        class="reveal mt-4 max-w-3xl text-h2"
        set:html={accent('A local partner, *not a call centre.*')}
      />
      <dl class="mt-16 grid gap-px overflow-hidden rounded-media bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((f) => (
          <div class="reveal flex flex-col-reverse gap-3 bg-sky-50 p-8">
            <dt class="text-sm text-muted">{f.label}</dt>
            <dd class="font-display text-7xl leading-none text-ocean-500">{f.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="mt-12 grid gap-8 text-sm text-muted sm:grid-cols-2 lg:grid-cols-4">
        <li class="reveal">
          <strong class="block text-base text-ink-900">Honest local advice</strong>Seasons, distances and crowds — from
          people who live here.
        </li>
        <li class="reveal">
          <strong class="block text-base text-ink-900">Real people on WhatsApp</strong>Message the same team before,
          during and after your trip.
        </li>
        <li class="reveal">
          <strong class="block text-base text-ink-900">Partner hotel rates</strong>Contracted rates and packages with
          hotels around the island.
        </li>
        <li class="reveal">
          <strong class="block text-base text-ink-900">Everything in one place</strong>Flights, visa, hotels, driver,
          guides — one point of contact.
        </li>
      </ul>
    </div>
  </section>

  <ReviewWall limit={6} index="07" />

  <section class="container-site pb-24" aria-labelledby="guides-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading index="08" eyebrow="Travel Guide" title="Know *before* you go." id="guides-heading" />
      <Button href="/travel-guide" variant="secondary">
        All guides <Icon name="arrow" class="size-4" />
      </Button>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {latestGuides.map((g) => (
        <Card
          href={`/travel-guide/${g.id}`}
          title={g.data.title}
          text={g.data.description}
          eyebrow={`Last checked ${dateFmt.format(g.data.lastChecked)}`}
          image={g.data.heroImage}
          imageAlt={g.data.heroAlt}
          tone={g.data.tone}
          aspect="aspect-[16/9]"
        />
      ))}
    </div>
  </section>

  {leader && (
    <section class="container-site pb-24" aria-labelledby="leader-heading">
      <div class="reveal grid gap-10 border-y border-line py-14 md:grid-cols-[auto_1fr] md:items-center">
        <div
          class="grid size-28 place-items-center rounded-full bg-ocean-900 font-display text-3xl text-lagoon-300"
          aria-hidden="true"
        >
          {leader.data.name
            .split(' ')
            .map((n) => n[0])
            .join('')}
        </div>
        <div>
          <h2
            id="leader-heading"
            class="max-w-3xl font-display text-[clamp(1.75rem,2.5vw+1rem,3rem)] leading-tight"
            set:html={accent('A family business, *personally run.*')}
          />
          <p class="mt-4 max-w-[60ch] text-muted">
            Paradise Travels has been led from our Colombo office since {SITE.foundingYear}. When you plan with us, you
            plan with the people who answer the phone.
          </p>
          <p class="detail mt-6 text-muted">
            Led by {leader.data.name} · {leader.data.role}
          </p>
          <a href="/about" class="mt-3 inline-block text-sm font-semibold text-primary underline underline-offset-4">
            Our story
          </a>
        </div>
      </div>
    </section>
  )}

  <CtaBlock />
</PageLayout>
