---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesTrio from '../components/home/ServicesTrio.astro';
import JourneyTypes from '../components/home/JourneyTypes.astro';
import IslandAtlas from '../components/home/IslandAtlas.astro';
import StaysShowcase from '../components/home/StaysShowcase.astro';
import WorldConnections from '../components/home/WorldConnections.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Media from '../components/ui/Media.astro';
import CtaBlock from '../components/ui/CtaBlock.astro';
import TicketCard from '../components/tours/TicketCard.astro';
import LeaderCard from '../components/ui/LeaderCard.astro';
import { getEntries, byOrder } from '../lib/content';
import { travelAgencySchema } from '../lib/schema-org';
import { dateFmt } from '../lib/labels';
import { SITE } from '../lib/site';
import { photo } from '../lib/photos';
import { accent } from '../lib/text';
import type { IconName } from '../lib/icons';

const tours = (await getEntries('tours')).sort(byOrder);
const featured = [
  ...tours.filter((t) => t.data.featured),
  ...tours.filter((t) => !t.data.featured && t.data.type !== 'round-trips'),
].slice(0, 4);
const guides = await getEntries('guides');
const latestGuides = guides.sort((a, b) => b.data.published.getTime() - a.data.published.getTime()).slice(0, 3);

// Only verifiable numbers (CLAUDE.md hard rule 1): years are derived from the founding year at build time.
const yearsTrading = new Date().getFullYear() - SITE.foundingYear;
const whyPhoto = photo('tea-picker');
const reasons: { icon: IconName; title: string; text: string }[] = [
  { icon: 'compass', title: 'Honest local advice', text: 'Seasons, distances and crowds — from people who live here.' },
  {
    icon: 'whatsapp',
    title: 'WhatsApp & KakaoTalk',
    text: 'Message the same team before, during and after your trip.',
  },
  { icon: 'car', title: 'Private car & driver', text: 'Every tour runs with your own vehicle and driver.' },
  {
    icon: 'grid',
    title: 'One point of contact',
    text: 'Tour, visa and flights — arranged by one team.',
  },
];
---

<PageLayout
  title="Paradise Travels | Sri Lanka Tour Agency"
  description="Colombo travel agency since 2007: Sri Lanka tours, visa help and air tickets."
  jsonLd={[travelAgencySchema()]}
  overlayHeader
>
  <Hero />
  <ServicesTrio index="01" />
  <JourneyTypes index="02" />
  <IslandAtlas index="03" />

  <section class="container-site py-24" aria-labelledby="tours-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        index="04"
        eyebrow="Itineraries"
        title="Start with a route. *Make it yours.*"
        id="tours-heading"
      />
      <Button href="/tours" variant="secondary">
        All tours <Icon name="arrow" class="size-4" />
      </Button>
    </div>
    <div class="mt-12 grid gap-6 xl:grid-cols-2">
      {featured.map((t) => (
        <TicketCard tour={t} />
      ))}
    </div>
  </section>

  <StaysShowcase index="05" />
  <WorldConnections index="06" />

  <section class="py-24" aria-labelledby="why-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <div class="reveal relative aspect-[4/5] overflow-hidden rounded-media shadow-card sm:aspect-[4/3] lg:aspect-[4/5]">
        <Media image={whyPhoto.image} alt={whyPhoto.alt} sizes="(min-width: 1024px) 38vw, calc(100vw - 2rem)" />
        <div class="absolute inset-x-4 bottom-4 flex items-center gap-4 rounded-card bg-ocean-900/90 p-4 text-white shadow-card ring-1 ring-gold-500/40 backdrop-blur-md sm:inset-x-6 sm:bottom-6 sm:p-5">
          <span class="font-display text-5xl leading-none text-gold-400">{yearsTrading}</span>
          <span class="text-sm leading-snug">
            <strong class="block font-semibold">Years arranging travel</strong>
            From our office in Nugegoda, Colombo, since {SITE.foundingYear}.
          </span>
        </div>
      </div>
      <div>
        <p class="reveal chapter">
          <span class="chapter-no">07</span>
          <span class="chapter-rule" aria-hidden="true"></span>
          <span>Why Paradise Travels</span>
        </p>
        <h2
          id="why-heading"
          class="reveal mt-4 max-w-2xl text-h2"
          set:html={accent('A family business, *personally run.*')}
        />
        <p class="reveal mt-5 max-w-[56ch] text-lg text-muted">
          One Colombo team plans your tour, sorts your visa and books your flights — and stays on WhatsApp and KakaoTalk
          until you fly home.
        </p>
        <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2">
          {reasons.map((r) => (
            <li class="reveal flex gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-gold-100 text-gold-700 ring-1 ring-gold-300 dark:bg-white/5 dark:text-gold-400">
                <Icon name={r.icon} class="size-5" />
              </span>
              <span>
                <strong class="block font-semibold">{r.title}</strong>
                <span class="mt-1 block text-sm text-muted">{r.text}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="reveal mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="/plan-your-trip">
            Plan my trip <Icon name="arrow" class="size-4" />
          </Button>
          <a href="/about" class="text-sm font-semibold text-primary underline underline-offset-4">
            Our story
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-site pb-24" aria-label="Leadership">
    <LeaderCard class="reveal mx-auto max-w-4xl" />
  </section>

  <section class="container-site pb-24" aria-labelledby="guides-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading index="08" eyebrow="Travel Guide" title="Know *before* you go." id="guides-heading" />
      <Button href="/travel-guide" variant="secondary">
        All guides <Icon name="arrow" class="size-4" />
      </Button>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {latestGuides.map((g) => (
        <Card
          href={`/travel-guide/${g.id}`}
          title={g.data.title}
          text={g.data.description}
          eyebrow={`Last checked ${dateFmt.format(g.data.lastChecked)}`}
          image={g.data.heroImage}
          imageAlt={g.data.heroAlt}
          tone={g.data.tone}
          aspect="aspect-[16/9]"
        />
      ))}
    </div>
  </section>

  <CtaBlock photoName="kandalama-pool" />
</PageLayout>
