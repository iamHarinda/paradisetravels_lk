# Copy to .env for local overrides. Real values live in Hostinger app settings — never commit them.

# `production` = indexable (robots allow + index meta). Anything else / unset = noindex (staging, local).
SITE_ENV=staging

# Phase 3 — forms & email
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Keystatic GitHub mode (production)
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Cloudflare cache purge (GitHub Actions secrets)
# CF_API_TOKEN=
# CF_ZONE_ID=
