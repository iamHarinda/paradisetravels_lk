# Copy to .env for local overrides. Real values live in Hostinger app settings — never commit them.

# `production` = indexable (robots allow + index meta). Anything else / unset = noindex (staging, local).
SITE_ENV=staging

# --- Search-engine verification (meta tags in <head>) ---
# Naver Search Advisor → 웹마스터 도구 → 사이트 등록 → HTML 태그: paste only the content="…" value (docs/13 §1)
# NAVER_SITE_VERIFICATION=
# Google Search Console → HTML tag method
# GOOGLE_SITE_VERIFICATION=

# --- Forms (all optional locally: without them, emails are logged to the console) ---
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Email — set ONE of: Resend API key, or SMTP (e.g. Hostinger email)
# RESEND_API_KEY=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=hello@paradisetravels.lk
# SMTP_PASS=
# MAIL_FROM="Paradise Travels <hello@paradisetravels.lk>"
# MAIL_TO=hello@paradisetravels.lk

# Lead store: every lead is POSTed here as JSON (Google Apps Script web app, Make/Zapier, Airtable automation…)
# LEAD_WEBHOOK_URL=

# --- Keystatic CMS, GitHub mode (production) — created by the Keystatic GitHub App setup at /keystatic ---
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Cloudflare cache purge (GitHub Actions secrets) ---
# CF_API_TOKEN=
# CF_ZONE_ID=
