# Copy to .env for local overrides. Real values live in Hostinger app settings — never commit them.

# `production` = indexable (robots allow + index meta). Anything else / unset = noindex (staging, local).
SITE_ENV=staging

# --- Cloudflare cache purge after deploy (optional) ---
# Zone ID: Cloudflare → paradisetravels.lk → Overview (right column). Token: My Profile → API Tokens → Create
# (Custom token, permission Zone · Cache Purge · Purge, zone paradisetravels.lk only).
# CF_ZONE_ID=
# CF_API_TOKEN=

# --- Search-engine verification (meta tags in <head>) ---
# Naver Search Advisor → 웹마스터 도구 → 사이트 등록 → HTML 태그: paste only the content="…" value (docs/13 §1)
# NAVER_SITE_VERIFICATION=
# Google Search Console → HTML tag method
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML Meta Tag (msvalidate.01): paste only the content="…" value
# BING_SITE_VERIFICATION=

# --- FTP deploy (npm run deploy) — hPanel → Files → FTP Accounts ---
# If the domain is proxied by Cloudflare, use the FTP IP / hostname shown in hPanel (not paradisetravels.lk).
# FTP_HOST=
# FTP_USER=
# FTP_PASSWORD=
# FTP_PORT=21
# FTP_REMOTE_DIR=public_html
# FTP_SECURE=true

# --- Forms ---
# Only the Turnstile SITE key is needed at build time. Mail settings + the Turnstile SECRET go in
# ~/paradise-config.php on the server (see paradise-config.sample.php).
# TURNSTILE_SITE_KEY=

# --- Keystatic CMS, GitHub mode (production) — created by the Keystatic GitHub App setup at /keystatic ---
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Cloudflare cache purge (GitHub Actions secrets) ---
# CF_API_TOKEN=
# CF_ZONE_ID=
